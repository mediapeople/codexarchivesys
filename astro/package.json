{
  "name": "codex-archive-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "node ../scripts/assert-workspace-path.mjs",
    "prebuild": "node ../scripts/assert-workspace-path.mjs && node ../scripts/generate-graph-json.mjs ./src/content ./public/graph.json",
    "prepreview": "node ../scripts/assert-workspace-path.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.5",
    "astro": "^5.17.1",
    "exifr": "^7.1.3",
    "sharp": "^0.34.5"
  }
}
