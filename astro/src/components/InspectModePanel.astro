---
import {
  buildMythmechLead,
  buildMythmechSupport,
  normalizePlatePrompt,
  summarizeMythmech,
} from '../lib/mythmech';
import { buildRespawnLead, parseRespawnSummary } from '../lib/respawn';

const { slug, packet, respawn, mythmech, platePrompt } = Astro.props as {
  slug: string;
  packet: unknown | null;
  respawn: string | null;
  mythmech: unknown | null;
  platePrompt: string | null;
};

function asRecord(value: unknown): Record<string, unknown> | null {
  return value && typeof value === 'object' && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : null;
}

function asString(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function uniqueStrings(values: string[]): string[] {
  return [...new Set(values.map((value) => value.trim()).filter(Boolean))];
}

function clipCopy(value: string, max = 180): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (!normalized || normalized.length <= max) {
    return normalized;
  }

  return `${normalized.slice(0, max).replace(/\s+\S*$/, '').replace(/[.?!,:;]+$/, '').trim()}…`;
}

function getPacketNotes(packetData: Record<string, unknown> | null): Array<{ label: string; value: string }> {
  return Array.isArray(packetData?.notes)
    ? packetData.notes
        .map((item) => asRecord(item))
        .filter((item): item is Record<string, unknown> => Boolean(item))
        .map((item) => ({
          label: asString(item.label) || 'Note',
          value: asString(item.value),
        }))
        .filter((item) => item.value)
        .slice(0, 2)
    : [];
}

function buildPacketSummary(packetData: Record<string, unknown> | null): string {
  if (!packetData) {
    return '';
  }

  const signal = asRecord(packetData.signal);
  const atmosphere = asRecord(packetData.atmosphere);
  const traumaWeather = asRecord(packetData.trauma_weather);
  const noteLead = getPacketNotes(packetData)[0]?.value || '';
  const signalTrack = asString(signal?.track);
  const signalMode = asString(signal?.mode);
  const atmosphereState = asString(atmosphere?.saturation_class) || asString(atmosphere?.pollen);
  const intakeRisk = asString(atmosphere?.intake_risk);
  const watch = asString(traumaWeather?.alert);

  return uniqueStrings([
    noteLead,
    signalTrack ? `Signal ${signalTrack}${signalMode ? ` in ${signalMode}` : ''}` : '',
    atmosphereState
      ? `Atmosphere ${atmosphereState}${intakeRisk ? ` with ${intakeRisk.toLowerCase()} intake risk` : ''}`
      : '',
    watch && watch !== 'NONE' ? `Watch ${watch}` : '',
  ]).join('. ');
}

const packetData = asRecord(packet);
const mythmechSummary = summarizeMythmech(mythmech);
const mythmechLead = mythmechSummary ? buildMythmechLead(mythmechSummary) : '';
const mythmechSupport = mythmechSummary ? buildMythmechSupport(mythmechSummary) : '';
const packetSummary = clipCopy(buildPacketSummary(packetData));
const packetNotes = getPacketNotes(packetData);
const normalizedRespawn = asString(respawn);
const respawnEntries = parseRespawnSummary(normalizedRespawn).filter((entry) => {
  if (entry.key === 'WATCH' && entry.value === 'NONE') return false;
  if (entry.key === 'SHADOW' && entry.value === 'NONE / CLEAR') return false;
  return true;
});
const respawnLead = clipCopy(buildRespawnLead(respawnEntries));
const normalizedPlatePrompt = normalizePlatePrompt(platePrompt) || '';
const hasInspectData =
  packetData !== null || mythmechSummary !== null || Boolean(normalizedRespawn) || Boolean(normalizedPlatePrompt);
const badges = uniqueStrings([
  packetData ? 'Snapshot' : '',
  mythmechSummary ? 'Mythmech' : '',
  normalizedRespawn ? 'Respawn' : '',
  normalizedPlatePrompt ? 'Plate Prompt' : '',
]);
const inspectLead = clipCopy(
  mythmechLead || packetSummary || respawnLead || 'Open the structural read only when you want it.'
);
const packetFacts = uniqueStrings([
  asString(packetData?.mode) ? `Mode ${asString(packetData?.mode)}` : '',
  (() => {
    const signal = asRecord(packetData?.signal);
    const signalValue = uniqueStrings([asString(signal?.track), asString(signal?.mode)]).join(' / ');
    return signalValue ? `Signal ${signalValue}` : '';
  })(),
  (() => {
    const atmosphere = asRecord(packetData?.atmosphere);
    const value = uniqueStrings([
      asString(atmosphere?.saturation_class) || asString(atmosphere?.pollen),
      asString(atmosphere?.intake_risk),
    ]).join(' / ');
    return value ? `Atmosphere ${value}` : '';
  })(),
  (() => {
    const traumaWeather = asRecord(packetData?.trauma_weather);
    const watch = asString(traumaWeather?.alert);
    return watch && watch !== 'NONE' ? `Watch ${watch}` : '';
  })(),
]);
const hudHref = `/codex/${encodeURIComponent(slug)}/hud`;
const plateHref = `/codex/${encodeURIComponent(slug)}/plate`;
---

{hasInspectData && (
  <details class="inspect-panel">
    <summary class="inspect-panel-summary">
      <span class="inspect-panel-sigil" aria-hidden="true">
        <span class="inspect-panel-sigil-core"></span>
      </span>

      <span class="inspect-panel-head">
        <span class="inspect-panel-overline">
          <span class="inspect-panel-label">Inspect Lens</span>
          {badges.length > 0 && (
            <span class="inspect-panel-badges" aria-label="Stored inspection layers">
              {badges.map((badge) => (
                <span>{badge}</span>
              ))}
            </span>
          )}
        </span>
        <span class="inspect-panel-copy">{inspectLead}</span>
        <span class="inspect-panel-meta">Structural memory stays offstage until you want the read.</span>
      </span>

      <span class="inspect-panel-toggle" aria-hidden="true"></span>
    </summary>

    <div class="inspect-panel-shell">
      <p class="inspect-panel-note">
        Objects stay primary. This layer is here when you want structure, continuity, or a usable return path.
      </p>

      {mythmechSummary && (
        <section class="inspect-section">
          <div class="inspect-section-head">
            <h2>Mythmech</h2>
            <p>{mythmechLead}</p>
          </div>

          <dl class="inspect-grid">
            <div class="inspect-card">
              <dt>Nodes / Edges</dt>
              <dd>{mythmechSummary.nodeCount} / {mythmechSummary.edgeCount}</dd>
            </div>
            <div class="inspect-card">
              <dt>Lineage</dt>
              <dd>{mythmechSummary.parentCount} parents / {mythmechSummary.childCount} children</dd>
            </div>
            {mythmechSummary.stateCount > 0 && (
              <div class="inspect-card">
                <dt>States</dt>
                <dd>{mythmechSummary.stateLabels.join(' · ')}</dd>
              </div>
            )}
            {mythmechSummary.spawnCandidateCount > 0 && (
              <div class="inspect-card">
                <dt>Spawn</dt>
                <dd>
                  {mythmechSummary.candidateLabels.length > 0
                    ? mythmechSummary.candidateLabels.join(' · ')
                    : `${mythmechSummary.spawnCandidateCount} candidates`}
                </dd>
              </div>
            )}
            {mythmechSummary.marginaliaCount > 0 && (
              <div class="inspect-card inspect-card--wide">
                <dt>Marginalia</dt>
                <dd>
                  {mythmechSummary.marginaliaTypes.length > 0
                    ? mythmechSummary.marginaliaTypes.join(' · ')
                    : `${mythmechSummary.marginaliaCount} entries`}
                </dd>
              </div>
            )}
          </dl>

          {mythmechSupport && <p class="inspect-support">{mythmechSupport}</p>}
        </section>
      )}

      {packetData && (
        <section class="inspect-section">
          <div class="inspect-section-head">
            <h2>Snapshot</h2>
            {packetSummary && <p>{packetSummary}</p>}
          </div>

          {packetFacts.length > 0 && (
            <ul class="inspect-facts" aria-label="Snapshot facts">
              {packetFacts.map((fact) => (
                <li>{fact}</li>
              ))}
            </ul>
          )}

          {packetNotes.length > 0 && (
            <div class="inspect-notes">
              {packetNotes.map((note) => (
                <article class="inspect-note">
                  <p>{note.label}</p>
                  <strong>{note.value}</strong>
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {respawnEntries.length > 0 && (
        <section class="inspect-section">
          <div class="inspect-section-head">
            <h2>Respawn</h2>
            {respawnLead && <p>{respawnLead}</p>}
          </div>

          <dl class="inspect-grid">
            {respawnEntries.map((entry) => (
              <div class:list={['inspect-card', entry.key === 'NOTES' && 'inspect-card--wide']}>
                <dt>{entry.label}</dt>
                <dd>{entry.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {normalizedPlatePrompt && (
        <details class="inspect-aux">
          <summary>Plate Prompt</summary>
          <p>{normalizedPlatePrompt}</p>
        </details>
      )}

      <div class="inspect-actions">
        <a href={hudHref}>Open HUD</a>
        <a href={plateHref}>Open Report</a>
      </div>
    </div>
  </details>
)}

<style>
  .inspect-panel {
    --inspect-line: rgba(216, 188, 132, 0.18);
    --inspect-line-strong: rgba(216, 188, 132, 0.28);
    --inspect-surface: rgba(26, 19, 12, 0.88);
    --inspect-surface-soft: rgba(255, 255, 255, 0.025);
    position: relative;
    margin: 2.4rem 0 0;
    max-width: 42rem;
    border: 1px solid var(--inspect-line);
    border-radius: 1.35rem;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(34, 24, 14, 0.9), rgba(15, 11, 8, 0.96)),
      rgba(201, 150, 58, 0.03);
    box-shadow:
      0 24px 64px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .inspect-panel::before,
  .inspect-panel::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .inspect-panel::before {
    inset: 1px;
    border-radius: inherit;
    background:
      radial-gradient(circle at 88% 0%, rgba(201, 150, 58, 0.13), transparent 32%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.03), transparent 40%),
      repeating-linear-gradient(
        90deg,
        rgba(201, 150, 58, 0.024) 0,
        rgba(201, 150, 58, 0.024) 1px,
        transparent 1px,
        transparent 12px
      );
    opacity: 0.85;
  }

  .inspect-panel::after {
    top: 0;
    left: 1.1rem;
    right: 1.1rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(229, 201, 141, 0.5), transparent);
  }

  .inspect-panel-summary {
    position: relative;
    z-index: 1;
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.1rem 1.08rem 1.12rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.9rem 1rem;
    align-items: center;
    transition: background 160ms ease;
  }

  .inspect-panel-summary::-webkit-details-marker {
    display: none;
  }

  .inspect-panel:hover .inspect-panel-summary,
  .inspect-panel[open] .inspect-panel-summary {
    background: rgba(255, 255, 255, 0.016);
  }

  .inspect-panel-sigil {
    position: relative;
    display: grid;
    width: 2.9rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--inspect-line);
    border-radius: 999px;
    background: radial-gradient(circle, rgba(201, 150, 58, 0.14), rgba(201, 150, 58, 0.03) 60%, transparent 72%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .inspect-panel-sigil::before {
    content: '';
    position: absolute;
    inset: 0.32rem;
    border: 1px dashed rgba(216, 188, 132, 0.24);
    border-radius: 999px;
  }

  .inspect-panel-sigil-core {
    width: 0.54rem;
    height: 0.54rem;
    border-radius: 999px;
    background: var(--accent-quote-strong);
    box-shadow:
      0 0 0 0.32rem rgba(201, 150, 58, 0.13),
      0 0 1rem rgba(201, 150, 58, 0.16);
  }

  .inspect-panel-head {
    min-width: 0;
    display: grid;
    gap: 0.38rem;
  }

  .inspect-panel-overline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.55rem;
  }

  .inspect-panel-label,
  .inspect-panel-badges span,
  .inspect-card dt,
  .inspect-note p,
  .inspect-aux summary,
  .inspect-actions a {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .inspect-panel-label {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.18rem 0.7rem;
    border: 1px solid var(--inspect-line);
    border-radius: 999px;
    color: var(--accent-quote-strong);
    background: rgba(255, 255, 255, 0.02);
  }

  .inspect-panel-copy {
    min-width: 0;
    color: var(--star);
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.96rem + 0.26vw, 1.16rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-wrap: balance;
  }

  .inspect-panel-meta {
    color: color-mix(in srgb, var(--mid) 82%, var(--gold) 18%);
    font-family: var(--font-ui);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .inspect-panel-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
  }

  .inspect-panel-badges span {
    padding: 0.16rem 0.48rem;
    border: 1px solid rgba(216, 188, 132, 0.16);
    border-radius: 999px;
    color: color-mix(in srgb, var(--mid) 68%, var(--gold) 32%);
    background: rgba(255, 255, 255, 0.016);
  }

  .inspect-panel-toggle {
    position: relative;
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid var(--inspect-line);
    border-radius: 999px;
    color: var(--gold);
    background: rgba(255, 255, 255, 0.02);
    transition:
      transform 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .inspect-panel-toggle::before,
  .inspect-panel-toggle::after {
    content: '';
    position: absolute;
    width: 0.78rem;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
  }

  .inspect-panel-toggle::after {
    transform: rotate(90deg);
  }

  .inspect-panel[open] .inspect-panel-toggle {
    transform: rotate(135deg);
    color: var(--star);
    border-color: var(--inspect-line-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .inspect-panel-shell {
    position: relative;
    z-index: 1;
    padding: 0 1.1rem 1.12rem;
    border-top: 1px solid rgba(216, 188, 132, 0.1);
    background: linear-gradient(180deg, rgba(16, 12, 9, 0.28), rgba(16, 12, 9, 0));
    animation: inspect-panel-reveal 220ms ease;
  }

  .inspect-panel-note {
    margin: 0.95rem 0 0;
    padding: 0.84rem 0.96rem;
    border: 1px solid rgba(216, 188, 132, 0.12);
    border-radius: 1rem;
    color: var(--text-soft);
    line-height: 1.68;
    background:
      linear-gradient(135deg, rgba(201, 150, 58, 0.06), rgba(255, 255, 255, 0.018)),
      var(--inspect-surface-soft);
  }

  .inspect-section {
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid rgba(216, 188, 132, 0.11);
    border-radius: 1.05rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.022), rgba(255, 255, 255, 0.012)),
      var(--inspect-surface);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.028);
  }

  .inspect-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .inspect-section-head h2 {
    margin: 0;
    color: var(--star);
    font-size: 1.04rem;
  }

  .inspect-section-head p,
  .inspect-support,
  .inspect-card dd,
  .inspect-aux p {
    margin: 0.38rem 0 0;
    color: var(--text-soft);
    line-height: 1.62;
  }

  .inspect-grid {
    margin: 0.8rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .inspect-card,
  .inspect-note {
    padding: 0.8rem 0.82rem 0.84rem;
    border: 1px solid rgba(216, 188, 132, 0.12);
    border-radius: 0.96rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.028), rgba(255, 255, 255, 0.014)),
      rgba(11, 9, 7, 0.62);
  }

  .inspect-card--wide {
    grid-column: 1 / -1;
  }

  .inspect-card dt,
  .inspect-note p,
  .inspect-aux summary {
    color: color-mix(in srgb, var(--mid) 70%, var(--gold) 30%);
  }

  .inspect-card dd {
    color: var(--star);
  }

  .inspect-facts {
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.6rem;
    list-style: none;
  }

  .inspect-facts li {
    padding: 0.28rem 0.62rem;
    border: 1px solid rgba(216, 188, 132, 0.11);
    border-radius: 999px;
    color: var(--text-soft);
    background: rgba(255, 255, 255, 0.018);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .inspect-notes {
    margin-top: 0.8rem;
    display: grid;
    gap: 0.7rem;
  }

  .inspect-note strong {
    display: block;
    margin-top: 0.3rem;
    color: var(--star);
    line-height: 1.6;
  }

  .inspect-aux {
    margin-top: 1rem;
  }

  .inspect-aux summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.2rem 0.72rem;
    border: 1px solid rgba(216, 188, 132, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.018);
  }

  .inspect-aux p {
    margin-top: 0.8rem;
    padding: 0.92rem 1rem;
    border: 1px solid rgba(216, 188, 132, 0.1);
    border-radius: 0.96rem;
    background: rgba(255, 255, 255, 0.015);
  }

  .inspect-actions {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.68rem;
  }

  .inspect-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.28rem 0.84rem;
    border: 1px solid rgba(216, 188, 132, 0.14);
    border-radius: 999px;
    color: var(--gold);
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      background 160ms ease;
  }

  .inspect-actions a:hover {
    color: var(--star);
    border-color: rgba(216, 188, 132, 0.26);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-1px);
  }

  @keyframes inspect-panel-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 720px) {
    .inspect-panel {
      border-radius: 1.1rem;
    }

    .inspect-panel-summary {
      padding: 0.96rem 0.92rem 1rem;
      gap: 0.82rem 0.84rem;
    }

    .inspect-panel-shell {
      padding: 0 0.92rem 0.96rem;
    }

    .inspect-grid {
      grid-template-columns: 1fr;
    }

    .inspect-card--wide {
      grid-column: auto;
    }

    .inspect-panel-meta {
      font-size: 0.58rem;
    }
  }
</style>
