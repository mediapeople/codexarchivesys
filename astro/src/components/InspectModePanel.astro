---
import { mergeMythmechMarginaliaEntries, normalizePlatePrompt, summarizeMythmech } from '../lib/mythmech';

const { slug, packet, respawn, mythmech, platePrompt, marginaliaEntries = [], forceVisible = false } = Astro.props as {
  slug: string;
  packet: unknown | null;
  respawn: string | null;
  mythmech: unknown | null;
  platePrompt: string | null;
  marginaliaEntries?: unknown[];
  forceVisible?: boolean;
};

function asRecord(value: unknown): Record<string, unknown> | null {
  return value && typeof value === 'object' && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : null;
}

const packetData = asRecord(packet);
const mythmechData = mergeMythmechMarginaliaEntries(mythmech, marginaliaEntries);
const mythmechSummary = summarizeMythmech(mythmechData);
const normalizedRespawn = typeof respawn === 'string' ? respawn.trim() : '';
const normalizedPlatePrompt = normalizePlatePrompt(platePrompt) || '';
const hasInspectData =
  forceVisible || packetData !== null || mythmechSummary !== null || Boolean(normalizedRespawn) || Boolean(normalizedPlatePrompt);
const hudHref = `/objects/${encodeURIComponent(slug)}/hud`;
---

{hasInspectData && (
  <section class="inspect-access" aria-label="HUD access">
    <p class="inspect-access-kicker">Enhanced Object</p>
    <a class="inspect-access-button" href={hudHref}>View HUD</a>
  </section>
)}

<style>
  .inspect-access {
    margin: 2.1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--field-line-soft);
  }

  .inspect-access-kicker,
  .inspect-access-button {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .inspect-access-kicker {
    margin: 0 0 0.62rem;
    color: var(--field-amber-label);
  }

  .inspect-access-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.3rem;
    padding: 0.34rem 0.96rem;
    border: 1px solid var(--field-accent-line);
    border-radius: var(--field-chip-radius);
    color: var(--field-amber-em);
    background: rgba(255, 255, 255, 0.012);
    text-decoration: none;
    transition:
      transform 140ms ease,
      color 140ms ease,
      border-color 140ms ease,
      background 140ms ease;
  }

  .inspect-access-button:hover {
    transform: translateY(-1px);
    border-color: var(--field-amber-accent);
    background: rgba(171, 143, 104, 0.12);
  }
</style>
