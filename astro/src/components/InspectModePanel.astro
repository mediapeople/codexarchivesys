---
import { mergeMythmechMarginaliaEntries, normalizePlatePrompt, summarizeMythmech } from '../lib/mythmech';

const { slug, packet, respawn, mythmech, platePrompt, marginaliaEntries = [], forceVisible = false, variant = 'inline' } = Astro.props as {
  slug: string;
  packet: unknown | null;
  respawn: string | null;
  mythmech: unknown | null;
  platePrompt: string | null;
  marginaliaEntries?: unknown[];
  forceVisible?: boolean;
  variant?: 'inline' | 'utility' | 'footer';
};

function asRecord(value: unknown): Record<string, unknown> | null {
  return value && typeof value === 'object' && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : null;
}

const packetData = asRecord(packet);
const mythmechData = mergeMythmechMarginaliaEntries(mythmech, marginaliaEntries);
const mythmechSummary = summarizeMythmech(mythmechData);
const normalizedRespawn = typeof respawn === 'string' ? respawn.trim() : '';
const normalizedPlatePrompt = normalizePlatePrompt(platePrompt) || '';
const hasInspectData =
  forceVisible || packetData !== null || mythmechSummary !== null || Boolean(normalizedRespawn) || Boolean(normalizedPlatePrompt);
const hudHref = `/objects/${encodeURIComponent(slug)}/hud`;
const kickerLabel = variant === 'footer' ? 'Dive deeper' : 'Enhanced Object';
const buttonLabel = variant === 'footer' ? 'Open Object HUD' : 'View HUD';
---

{hasInspectData && (
  <section
    class:list={[
      'inspect-access',
      variant === 'utility' && 'inspect-access--utility',
      variant === 'footer' && 'inspect-access--footer',
    ]}
    aria-label="HUD access"
  >
    <p class="inspect-access-kicker">{kickerLabel}</p>
    <a class="inspect-access-button" href={hudHref}>{buttonLabel}</a>
  </section>
)}

<style>
  .inspect-access {
    display: grid;
    gap: 0.62rem;
    margin: 2.1rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--field-line-soft);
  }

  .inspect-access--utility {
    margin: 0;
    padding: 0;
    border-top: 0;
    gap: 0.34rem;
    justify-items: end;
    align-content: start;
  }

  .inspect-access--footer {
    gap: 0.46rem;
    margin-top: 2.6rem;
    padding-top: 1.05rem;
  }

  .inspect-access-kicker,
  .inspect-access-button {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .inspect-access-kicker {
    margin: 0;
    color: var(--field-amber-label);
  }

  .inspect-access-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.3rem;
    padding: 0.34rem 0.96rem;
    border: 1px solid var(--field-accent-line);
    border-radius: var(--field-chip-radius);
    color: var(--field-amber-em);
    background: rgba(255, 255, 255, 0.012);
    text-decoration: none;
    transition:
      transform 140ms ease,
      color 140ms ease,
      border-color 140ms ease,
      background 140ms ease;
  }

  .inspect-access-button:hover {
    transform: translateY(-1px);
    border-color: var(--field-amber-accent);
    background: rgba(171, 143, 104, 0.12);
  }

  .inspect-access--utility .inspect-access-button {
    min-height: 0;
    padding: 0.38rem 0.76rem 0.34rem;
    border-color: rgba(171, 143, 104, 0.34);
    background: rgba(255, 255, 255, 0.008);
  }

  .inspect-access--footer .inspect-access-kicker {
    color: var(--field-amber-label);
  }

  .inspect-access--footer .inspect-access-button {
    min-height: 0;
    padding: 0.42rem 0.86rem 0.38rem;
    border-color: rgba(171, 143, 104, 0.32);
    background: rgba(255, 255, 255, 0.008);
  }

  @media (max-width: 700px) {
    .inspect-access--utility {
      justify-items: start;
      gap: 0.18rem;
    }

    .inspect-access--utility .inspect-access-button {
      justify-content: flex-start;
      min-height: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      color: var(--field-amber-em);
    }

    .inspect-access--utility .inspect-access-button:hover {
      transform: none;
      border-color: transparent;
      background: none;
      color: var(--star);
    }

    .inspect-access--footer {
      margin-top: 2.1rem;
      padding-top: 0.92rem;
    }
  }
</style>
