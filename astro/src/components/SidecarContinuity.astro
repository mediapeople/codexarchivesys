---
const { slug, packet, respawn } = Astro.props as {
  slug: string;
  packet: unknown | null;
  respawn: string | null;
};

function asString(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function clipCopy(value: string, max = 132): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (!normalized || normalized.length <= max) {
    return normalized;
  }

  return `${normalized.slice(0, max).replace(/\s+\S*$/, '').replace(/[.?!,:;]+$/, '').trim()}…`;
}

const hasPacket = packet !== null;
const respawnCopy = asString(respawn);
const hasRespawn = Boolean(respawnCopy);
const respawnLead = clipCopy(respawnCopy.split('\n').find(Boolean) || '');
const hudHref = `/codex/${encodeURIComponent(slug)}/hud`;
const plateHref = `/codex/${encodeURIComponent(slug)}/plate`;
---

{(hasPacket || hasRespawn) && (
  <section class="continuity-panel">
    <div class="continuity-head">
      <div>
        <p class="continuity-kicker">Continuity</p>
        <p class="continuity-copy">
          {respawnLead || 'Packet continuity is stored for this object. Open the alternate surfaces when you want the operational read.'}
        </p>
      </div>

      <div class="continuity-actions">
        <a href={hudHref} target="_blank" rel="noreferrer">View HUD</a>
        <a href={plateHref} target="_blank" rel="noreferrer">Report</a>
      </div>
    </div>
  </section>
)}

<style>
  .continuity-panel {
    max-width: 42rem;
    margin: 1.8rem 0 2.2rem;
    padding: 0.9rem 1rem 0.94rem;
    border: 1px solid rgba(201, 150, 58, 0.18);
    background: rgba(201, 150, 58, 0.04);
  }

  .continuity-head {
    display: flex;
    justify-content: space-between;
    gap: 0.9rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .continuity-kicker,
  .continuity-actions a {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .continuity-kicker {
    margin: 0;
    color: var(--mid);
  }

  .continuity-copy {
    margin: 0.45rem 0 0;
    color: var(--mid);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 31rem;
  }

  .continuity-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .continuity-actions a {
    color: var(--gold);
    text-decoration: none;
  }

  .continuity-actions a:hover {
    color: var(--star);
  }

  @media (max-width: 720px) {
    .continuity-panel {
      max-width: none;
      margin-bottom: 1.9rem;
    }
  }
</style>
