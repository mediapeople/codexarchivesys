---
import { buildRespawnLead, parseRespawnSummary } from '../lib/respawn';

const { slug, packet, respawn } = Astro.props as {
  slug: string;
  packet: unknown | null;
  respawn: string | null;
};

function asString(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function clipCopy(value: string, max = 132): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (!normalized || normalized.length <= max) {
    return normalized;
  }

  return `${normalized.slice(0, max).replace(/\s+\S*$/, '').replace(/[.?!,:;]+$/, '').trim()}…`;
}

const hasPacket = packet !== null;
const respawnCopy = asString(respawn);
const hasRespawn = Boolean(respawnCopy);
const respawnEntries = parseRespawnSummary(respawnCopy);
const respawnLead = clipCopy(buildRespawnLead(respawnEntries));
const compactRespawnEntries = respawnEntries.filter((entry) => {
  if (entry.key === 'WATCH' && entry.value === 'NONE') return false;
  if (entry.key === 'SHADOW' && entry.value === 'NONE / CLEAR') return false;
  if (entry.key === 'NOTES') {
    return !/^mode:/i.test(entry.value);
  }
  return true;
});
const hudHref = `/codex/${encodeURIComponent(slug)}/hud`;
const plateHref = `/codex/${encodeURIComponent(slug)}/plate`;
---

{(hasPacket || hasRespawn) && (
  <section class="continuity-panel">
    <div class="continuity-head">
      <div>
        <p class="continuity-kicker">Continuity</p>
        <p class="continuity-copy">
          {hasRespawn
            ? 'Stored return path for this object.'
            : 'Packet continuity is stored for this object. Open the alternate surfaces when you want the operational read.'}
        </p>
      </div>

      <div class="continuity-actions">
        <a href={hudHref} target="_blank" rel="noreferrer">View HUD</a>
        <a href={plateHref} target="_blank" rel="noreferrer">Report</a>
      </div>
    </div>

    {hasRespawn && (
      <article class="continuity-respawn-card">
        <p class="continuity-respawn-kicker">Respawn</p>
        {respawnLead && <p class="continuity-respawn-title">{respawnLead}</p>}

        {compactRespawnEntries.length > 0 && (
          <dl class="continuity-respawn-grid">
            {compactRespawnEntries.map((entry) => (
              <div class:list={['continuity-respawn-item', entry.key === 'NOTES' && 'continuity-respawn-item--wide']}>
                <dt>{entry.label}</dt>
                <dd>{entry.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </article>
    )}
  </section>
)}

<style>
  .continuity-panel {
    max-width: 42rem;
    margin: 1.8rem 0 2.2rem;
    padding: 0.78rem 0.92rem 0.84rem;
    border: 1px solid rgba(201, 150, 58, 0.18);
    background: rgba(201, 150, 58, 0.04);
  }

  .continuity-head {
    display: flex;
    justify-content: space-between;
    gap: 0.9rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .continuity-kicker,
  .continuity-actions a {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .continuity-kicker {
    margin: 0;
    color: var(--mid);
  }

  .continuity-copy {
    margin: 0.28rem 0 0;
    color: var(--mid);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 24rem;
  }

  .continuity-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .continuity-actions a {
    color: var(--gold);
    text-decoration: none;
  }

  .continuity-actions a:hover {
    color: var(--star);
  }

  .continuity-respawn-card {
    margin-top: 0.72rem;
    padding: 0.78rem 0.84rem 0.82rem;
    border: 1px solid rgba(201, 150, 58, 0.14);
    background: rgba(255, 255, 255, 0.02);
  }

  .continuity-respawn-kicker,
  .continuity-respawn-grid dt {
    margin: 0;
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .continuity-respawn-title {
    margin: 0.34rem 0 0;
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    line-height: 1.65;
    max-width: 34rem;
    text-transform: uppercase;
  }

  .continuity-respawn-grid {
    margin: 0.62rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.56rem 0.72rem;
  }

  .continuity-respawn-item {
    padding-top: 0.48rem;
    border-top: 1px solid rgba(201, 150, 58, 0.12);
  }

  .continuity-respawn-item--wide {
    grid-column: 1 / -1;
  }

  .continuity-respawn-grid dd {
    margin: 0.24rem 0 0;
    color: var(--text-soft);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    line-height: 1.45;
  }

  @media (max-width: 720px) {
    .continuity-panel {
      max-width: none;
      margin-bottom: 1.9rem;
    }

    .continuity-respawn-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
