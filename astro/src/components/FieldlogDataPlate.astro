---
interface FieldlogSpec {
  label: string;
  value: string;
  note?: string;
}

interface PlateSpec extends FieldlogSpec {
  key: string;
}

interface Props {
  title: string;
  specs: FieldlogSpec[];
  excerpt?: string;
  location?: string;
  dateLabel?: string;
}

const { title, specs = [], excerpt = '', location = '', dateLabel = '' } = Astro.props as Props;

function normalizeLabel(label: string): string {
  return label.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
}

const normalizedSpecs: PlateSpec[] = specs.map((spec) => ({
  ...spec,
  key: normalizeLabel(spec.label),
}));

const specByKey = new Map(normalizedSpecs.map((spec) => [spec.key, spec] as const));
const leadSpec = specByKey.get('beer') ?? normalizedSpecs[0] ?? null;
const styleSpec = specByKey.get('style') ?? null;
const orderedCardKeys = ['brewery', 'site', 'hops', 'milestone', 'glass'];
const usedKeys = new Set<string>();

if (leadSpec) {
  usedKeys.add(leadSpec.key);
}

if (styleSpec) {
  usedKeys.add(styleSpec.key);
}

const primaryCards = orderedCardKeys
  .map((key) => specByKey.get(key))
  .filter((spec): spec is PlateSpec => Boolean(spec))
  .filter((spec) => !usedKeys.has(spec.key));

for (const spec of primaryCards) {
  usedKeys.add(spec.key);
}

const supportingCards = normalizedSpecs.filter((spec) => !usedKeys.has(spec.key));
const plateCards = [...primaryCards, ...supportingCards];
const heroSummary = styleSpec?.note || leadSpec?.note || excerpt;
const signalRows = normalizedSpecs.filter(
  (spec) => Boolean(spec.note) && spec.key !== leadSpec?.key && spec.key !== styleSpec?.key
);

const metaItems = [
  location ? { label: 'Location', value: location } : null,
  dateLabel ? { label: 'Logged', value: dateLabel } : null,
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<section class="fieldlog-plate-shell page-plate" aria-labelledby="fieldlog-plate-title">
  <header class="fieldlog-plate-header">
    <div class="fieldlog-plate-heading">
      <p class="fieldlog-plate-kicker">Structured Readout</p>
      <p class="fieldlog-plate-ruler" aria-hidden="true">Plate // calibrated tasting surface</p>
    </div>
    <div class="fieldlog-plate-stamp">
      <span>Fieldlog Plate</span>
      <strong>{styleSpec?.value || leadSpec?.label || 'Specimen'}</strong>
    </div>
  </header>

  <div class="fieldlog-plate-grid">
    <section class="fieldlog-plate-hero">
      <p class="fieldlog-plate-code">{leadSpec?.label || 'Field Plate'}</p>
      <h2 id="fieldlog-plate-title">{leadSpec?.value || title}</h2>
      {styleSpec?.value && <p class="fieldlog-plate-style">{styleSpec.value}</p>}
      {heroSummary && <p class="fieldlog-plate-summary">{heroSummary}</p>}

      {metaItems.length > 0 && (
        <ul class="fieldlog-plate-meta" aria-label="Plate metadata">
          {metaItems.map((item) => (
            <li>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </li>
          ))}
        </ul>
      )}
    </section>

    {plateCards.length > 0 && (
      <section class="fieldlog-plate-rack" aria-label="Structured field details">
        {plateCards.map((spec) => (
          <article class="fieldlog-plate-card">
            <p class="fieldlog-plate-card-label">{spec.label}</p>
            <strong>{spec.value}</strong>
            {spec.note && <span>{spec.note}</span>}
          </article>
        ))}
      </section>
    )}
  </div>

  {signalRows.length > 0 && (
    <section class="fieldlog-plate-signals" aria-label="Signal notes">
      <p class="fieldlog-plate-signals-label">Signal Notes</p>
      <div class="fieldlog-plate-signals-grid">
        {signalRows.map((spec) => (
          <article class="fieldlog-plate-signal">
            <p>{spec.label}</p>
            <strong>{spec.note}</strong>
          </article>
        ))}
      </div>
    </section>
  )}
</section>

<style>
  .fieldlog-plate-shell {
    --plate-line: var(--object-plate-line, rgba(112, 150, 178, 0.34));
    --plate-line-soft: var(--object-plate-line-soft, rgba(112, 150, 178, 0.18));
    --plate-highlight: rgba(232, 240, 246, 0.08);
    --plate-copy: rgba(243, 238, 228, 0.94);
    --plate-muted: var(--object-plate-muted, rgba(213, 223, 232, 0.74));
    --plate-label: var(--object-plate-label, rgba(166, 196, 221, 0.84));
    --plate-border: var(--object-plate-line-soft, rgba(112, 150, 178, 0.2));
    --plate-frame: color-mix(in srgb, var(--plate-line-soft) 92%, transparent);
    --plate-inset: 8px;
    --plate-shadow: 0 22px 48px rgba(0, 0, 0, 0.24);
    --plate-surface: var(--object-plate-surface, linear-gradient(180deg, rgba(14, 18, 25, 0.98), rgba(10, 13, 19, 0.99)));
    --plate-tint: var(--object-plate-tint, rgba(98, 132, 160, 0.14));
    --plate-tint-secondary: var(--object-plate-tint-secondary, rgba(73, 108, 138, 0.08));
    position: relative;
    margin: 2.5rem 0 2.35rem;
    max-width: min(1160px, 100%);
    padding: clamp(1.18rem, 2.05vw, 1.78rem);
  }

  .fieldlog-plate-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fieldlog-plate-shell::before {
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.04), transparent 18%),
      linear-gradient(180deg, rgba(220, 233, 243, 0.03), transparent 42%);
    opacity: 0.52;
  }

  .fieldlog-plate-header,
  .fieldlog-plate-grid,
  .fieldlog-plate-signals {
    position: relative;
    z-index: 1;
  }

  .fieldlog-plate-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1.12rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--plate-line-soft);
  }

  .fieldlog-plate-kicker,
  .fieldlog-plate-ruler,
  .fieldlog-plate-code,
  .fieldlog-plate-card-label,
  .fieldlog-plate-signals-label,
  .fieldlog-plate-signal p,
  .fieldlog-plate-meta span,
  .fieldlog-plate-stamp span {
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: var(--ls-ui-wide);
  }

  .fieldlog-plate-kicker {
    margin: 0 0 0.28rem;
    color: var(--plate-label);
    font-size: 10px;
  }

  .fieldlog-plate-ruler {
    margin: 0;
    color: color-mix(in srgb, var(--plate-label) 76%, transparent);
    font-size: 0.76rem;
    line-height: 1.4;
  }

  .fieldlog-plate-stamp {
    min-width: 14.5rem;
    padding: 0.06rem 0 0.06rem 1.18rem;
    text-align: right;
    border-left: 1px solid var(--plate-line-soft);
  }

  .fieldlog-plate-stamp span {
    display: block;
    margin: 0 0 0.28rem;
    color: color-mix(in srgb, var(--plate-label) 80%, transparent);
    font-size: 10px;
  }

  .fieldlog-plate-stamp strong {
    color: var(--plate-copy);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.1;
    font-weight: 600;
  }

  .fieldlog-plate-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(360px, 0.94fr);
    gap: 0;
    align-items: stretch;
  }

  .fieldlog-plate-hero,
  .fieldlog-plate-card,
  .fieldlog-plate-signal {
    background: none;
    border: 0;
    box-shadow: none;
    border-radius: 0;
  }

  .fieldlog-plate-hero {
    padding: clamp(1.28rem, 2.2vw, 1.92rem) 1.6rem clamp(1.3rem, 2.2vw, 1.92rem) 0.38rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.12rem;
    border-right: 1px solid var(--plate-line-soft);
  }

  .fieldlog-plate-code {
    margin: 0;
    color: var(--plate-label);
    font-size: 10px;
  }

  .fieldlog-plate-hero h2 {
    margin: 0;
    max-width: 10ch;
    color: var(--plate-copy);
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 4.6vw, 3.75rem);
    line-height: 0.94;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .fieldlog-plate-style {
    width: fit-content;
    margin: 0;
    padding: 0.36rem 0.7rem 0.38rem;
    border: 1px solid color-mix(in srgb, var(--plate-line) 88%, transparent);
    border-radius: 999px;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--plate-label) 16%, transparent),
        transparent
      ),
      rgba(23, 31, 41, 0.52);
    color: color-mix(in srgb, var(--plate-copy) 94%, var(--plate-label) 6%);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .fieldlog-plate-summary {
    margin: 0;
    max-width: 40ch;
    color: var(--plate-muted);
    font-size: 1.02rem;
    line-height: 1.66;
    text-wrap: balance;
  }

  .fieldlog-plate-meta {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    padding-top: 1.02rem;
    border-top: 1px solid var(--plate-line-soft);
  }

  .fieldlog-plate-meta li {
    flex: 1 1 12rem;
    min-width: 12rem;
    padding: 0 1.08rem 0 0;
  }

  .fieldlog-plate-meta li + li {
    padding-left: 1.08rem;
    border-left: 1px solid var(--plate-line-soft);
  }

  .fieldlog-plate-meta span {
    display: block;
    margin: 0 0 0.3rem;
    color: color-mix(in srgb, var(--plate-label) 78%, transparent);
    font-size: 9px;
  }

  .fieldlog-plate-meta strong {
    display: block;
    color: rgba(247, 239, 225, 0.94);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .fieldlog-plate-rack {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding-left: 1.28rem;
  }

  .fieldlog-plate-card {
    min-height: 12rem;
    padding: 1.16rem 0 1.22rem 1.16rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.7rem;
    border-top: 1px solid transparent;
    border-left: 1px solid transparent;
  }

  .fieldlog-plate-card:nth-child(2n) {
    border-left-color: var(--plate-line-soft);
  }

  .fieldlog-plate-card:nth-child(n + 3) {
    border-top-color: var(--plate-line-soft);
  }

  .fieldlog-plate-card-label {
    margin: 0;
    color: var(--plate-label);
    font-size: 10px;
  }

  .fieldlog-plate-card strong {
    display: block;
    color: var(--plate-copy);
    font-size: clamp(1.18rem, 1.8vw, 1.5rem);
    line-height: 1.16;
    font-weight: 600;
    text-wrap: balance;
  }

  .fieldlog-plate-card span {
    display: block;
    color: var(--plate-muted);
    font-size: 0.94rem;
    line-height: 1.56;
    text-wrap: balance;
  }

  .fieldlog-plate-signals {
    margin-top: 1.08rem;
    padding-top: 1.08rem;
    border-top: 1px solid var(--plate-line-soft);
  }

  .fieldlog-plate-signals-label {
    margin: 0 0 0.74rem;
    color: color-mix(in srgb, var(--plate-label) 82%, transparent);
    font-size: 10px;
  }

  .fieldlog-plate-signals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem 1.05rem;
  }

  .fieldlog-plate-signal {
    min-height: 0;
    padding-top: 0.92rem;
    border-top: 1px solid var(--plate-line-soft);
  }

  @media (min-width: 1100px) {
    .fieldlog-plate-shell {
      max-width: min(1200px, 100%);
      padding: 1.48rem 1.58rem 1.66rem;
    }

    .fieldlog-plate-grid {
      grid-template-columns: minmax(0, 1.14fr) minmax(420px, 0.86fr);
    }

    .fieldlog-plate-card {
      min-height: 12.6rem;
      padding: 1.2rem 0 1.3rem 1.22rem;
    }
  }

  .fieldlog-plate-signal p {
    margin: 0 0 0.48rem;
    color: color-mix(in srgb, var(--plate-label) 76%, transparent);
    font-size: 10px;
  }

  .fieldlog-plate-signal strong {
    display: block;
    color: rgba(242, 236, 225, 0.9);
    font-size: 0.98rem;
    line-height: 1.58;
    font-weight: 500;
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .fieldlog-plate-grid {
      grid-template-columns: 1fr;
    }

    .fieldlog-plate-stamp {
      text-align: left;
      min-width: 0;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--plate-line-soft);
      padding-top: 0.88rem;
    }

    .fieldlog-plate-hero {
      padding-right: 0;
      padding-left: 0;
      border-right: 0;
      border-bottom: 1px solid var(--plate-line-soft);
      padding-bottom: 1.28rem;
    }

    .fieldlog-plate-rack {
      padding-left: 0;
      padding-top: 1.02rem;
    }
  }

  @media (max-width: 680px) {
    .fieldlog-plate-rack {
      grid-template-columns: 1fr;
    }

    .fieldlog-plate-card,
    .fieldlog-plate-signal {
      min-height: 0;
    }

    .fieldlog-plate-card {
      padding-left: 0;
      border-left: 0;
      border-top-color: var(--plate-line-soft);
    }

    .fieldlog-plate-card:first-child {
      border-top-color: transparent;
      padding-top: 0;
    }
  }

  @media (max-width: 560px) {
    .fieldlog-plate-shell {
      padding: 0.95rem;
      border-radius: 0;
    }

    .fieldlog-plate-header {
      margin-bottom: 0.95rem;
    }

    .fieldlog-plate-hero {
      padding: 1rem;
    }

    .fieldlog-plate-hero h2 {
      max-width: 100%;
      font-size: clamp(2rem, 11vw, 2.7rem);
    }

    .fieldlog-plate-summary {
      font-size: 0.98rem;
    }

    .fieldlog-plate-meta {
      display: grid;
      grid-template-columns: 1fr;
    }

    .fieldlog-plate-meta li {
      min-width: 0;
      padding-right: 0;
    }

    .fieldlog-plate-meta li + li {
      padding-left: 0;
      margin-top: 0.82rem;
      padding-top: 0.82rem;
      border-left: 0;
      border-top: 1px solid var(--plate-line-soft);
    }
  }
</style>
