---
import { getTypeLabel } from '../lib/archive';

const { slug, type, summary, packet, respawn, placement = 'flow' } = Astro.props as {
  slug: string;
  type: string;
  summary?: string;
  packet: unknown | null;
  respawn: string | null;
  placement?: 'flow' | 'rail';
};

function asRecord(value: unknown): Record<string, unknown> | null {
  return value && typeof value === 'object' && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : null;
}

function asString(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function uniqueStrings(values: string[]): string[] {
  return [...new Set(values.map((value) => value.trim()).filter(Boolean))];
}

function clipCopy(value: string, max = 160): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (!normalized || normalized.length <= max) {
    return normalized;
  }

  return `${normalized.slice(0, max).replace(/\s+\S*$/, '').replace(/[.?!,:;]+$/, '').trim()}…`;
}

function getNoteValues(packetData: Record<string, unknown> | null): string[] {
  return Array.isArray(packetData?.notes)
    ? packetData.notes
        .map((item) => asString(asRecord(item)?.value))
        .filter(Boolean)
    : [];
}

function buildPacketResult(packetData: Record<string, unknown> | null): string {
  if (!packetData) {
    return '';
  }

  const signal = asRecord(packetData.signal);
  const atmosphere = asRecord(packetData.atmosphere);
  const traumaWeather = asRecord(packetData.trauma_weather);
  const noteValues = getNoteValues(packetData).slice(0, 1);

  const signalTrack = asString(signal?.track);
  const signalMode = asString(signal?.mode);
  const atmosphereState = asString(atmosphere?.saturation_class) || asString(atmosphere?.pollen);
  const intakeRisk = asString(atmosphere?.intake_risk);
  const traumaAlert = asString(traumaWeather?.alert);

  const detailParts = [
    signalTrack ? `Signal ${signalTrack}${signalMode ? ` in ${signalMode}` : ''}` : '',
    atmosphereState
      ? `Atmosphere ${atmosphereState}${intakeRisk ? ` with ${intakeRisk.toLowerCase()} intake risk` : ''}`
      : '',
    traumaAlert && traumaAlert !== 'NONE' ? `Watch ${traumaAlert}` : '',
  ].filter(Boolean);

  return [...noteValues, ...detailParts].join('. ').replace(/\s+/g, ' ').trim();
}

const packetData = asRecord(packet);
const hasLead = packetData !== null;
const summaryCopy = asString(summary);
const respawnCopy = asString(respawn);

const artifact = asRecord(packetData?.artifact);
const signal = asRecord(packetData?.signal);
const atmosphere = asRecord(packetData?.atmosphere);
const traumaWeather = asRecord(packetData?.trauma_weather);

const typeLabel = getTypeLabel(type);
const noteValues = getNoteValues(packetData);
const primaryResult = clipCopy(
  noteValues[0] || buildPacketResult(packetData) || summaryCopy || respawnCopy.split('\n').find(Boolean) || ''
);

const modeValue = asString(packetData?.mode);
const signalValue = uniqueStrings([asString(signal?.track), asString(signal?.mode)]).join(' / ');
const fieldValue = uniqueStrings([asString(artifact?.sector), asString(artifact?.region)]).join(' / ');
const atmosphereValue = uniqueStrings([
  asString(atmosphere?.saturation_class) || asString(atmosphere?.pollen),
  asString(atmosphere?.intake_risk),
]).join(' / ');
const watchValue = asString(traumaWeather?.alert);
const packetId = asString(artifact?.id);

const supportCopy = clipCopy(
  uniqueStrings([
    modeValue ? `Mode ${modeValue}` : '',
    signalValue ? `Signal ${signalValue}` : '',
    atmosphereValue ? `Atmosphere ${atmosphereValue}` : '',
    watchValue && watchValue !== 'NONE' ? `Watch ${watchValue}` : '',
  ]).join(' · '),
  150
);

const detailLine = clipCopy(
  uniqueStrings([
    typeLabel ? `${typeLabel} object` : '',
    fieldValue ? `Field ${fieldValue}` : '',
    packetId ? `Packet ${packetId}` : '',
  ]).join(' · '),
  144
);

const hudHref = `/codex/${encodeURIComponent(slug)}/hud`;
const plateHref = `/codex/${encodeURIComponent(slug)}/plate`;
---

{hasLead && (
  <section class:list={['field-result-lead', placement === 'rail' && 'field-result-lead--rail']}>
    <span class="field-result-corner">Enhanced Object</span>
    <div class="field-result-head">
      <div class="field-result-ident">
        <p class="field-result-kicker">Enhanced Object</p>
        <div class="field-result-badges" aria-label="Packet status">
          <span>Snapshot</span>
        </div>
      </div>

      <nav class="field-result-actions" aria-label="Packet views">
        <a href={hudHref} target="_blank" rel="noreferrer">
          <span class="field-result-glyph" aria-hidden="true">◎</span>
          <span>View HUD</span>
        </a>
        <a href={plateHref} target="_blank" rel="noreferrer">
          <span class="field-result-glyph" aria-hidden="true">▣</span>
          <span>Report</span>
        </a>
      </nav>
    </div>

    {primaryResult && <p class="field-result-summary">{primaryResult}</p>}
    {supportCopy && <p class="field-result-support">{supportCopy}</p>}
    {detailLine && <p class="field-result-detail-line">{detailLine}</p>}
  </section>
)}

<style>
  .field-result-lead {
    position: relative;
    max-width: 46rem;
    margin: 1.4rem 0 2rem;
    padding: 0.95rem 1rem 1rem;
    border: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
    background:
      linear-gradient(135deg, rgba(201, 150, 58, 0.05), rgba(255, 255, 255, 0.01)),
      rgba(201, 150, 58, 0.025);
  }

  .field-result-corner {
    display: none;
  }

  .field-result-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .field-result-ident {
    min-width: 0;
  }

  .field-result-kicker,
  .field-result-actions a,
  .field-result-chip dt {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .field-result-kicker {
    margin: 0;
    color: var(--mid);
  }

  .field-result-badges {
    margin-top: 0.34rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }

  .field-result-badges span {
    padding: 0.18rem 0.48rem;
    border: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--mid) 76%, var(--gold) 24%);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-ui);
    font-size: 0.58rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .field-result-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .field-result-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    color: var(--gold);
    text-decoration: none;
  }

  .field-result-glyph {
    display: inline-block;
    font-size: 0.88em;
    line-height: 1;
  }

  .field-result-actions a:hover {
    color: var(--star);
  }

  .field-result-summary {
    margin: 0.68rem 0 0;
    color: var(--star);
    font-size: clamp(0.98rem, 0.94rem + 0.32vw, 1.12rem);
    line-height: 1.55;
  }

  .field-result-support {
    margin: 0.48rem 0 0;
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .field-result-detail-line {
    margin: 0.68rem 0 0;
    color: color-mix(in srgb, var(--mid) 68%, var(--gold) 32%);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .field-result-lead--rail {
    max-width: none;
    margin: 0;
    padding: 0.9rem 1rem 0.92rem;
  }

  .field-result-lead--rail .field-result-corner {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.46rem;
    border: 1px solid color-mix(in srgb, var(--gold) 18%, transparent);
    color: color-mix(in srgb, var(--mid) 70%, var(--gold) 30%);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--font-ui);
    font-size: 0.56rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .field-result-lead--rail .field-result-kicker {
    opacity: 0;
    height: 0;
    margin: 0;
    overflow: hidden;
  }

  .field-result-lead--rail .field-result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    flex-wrap: wrap;
    padding-right: 5.8rem;
  }

  .field-result-lead--rail .field-result-ident {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .field-result-lead--rail .field-result-badges {
    margin-top: 0;
  }

  .field-result-lead--rail .field-result-badges span {
    font-size: 0.54rem;
    letter-spacing: 0.1em;
  }

  .field-result-lead--rail .field-result-actions {
    margin-top: 0;
    gap: 0.66rem;
  }

  .field-result-lead--rail .field-result-actions a {
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .field-result-lead--rail .field-result-summary {
    margin-top: 0.72rem;
    font-size: 1rem;
    line-height: 1.52;
  }

  .field-result-lead--rail .field-result-support {
    font-size: 0.76rem;
    line-height: 1.52;
  }

  .field-result-lead--rail .field-result-detail-line {
    margin-top: 0.58rem;
    font-size: 0.68rem;
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .field-result-lead {
      max-width: none;
      margin-bottom: 1.6rem;
      padding-inline: 0.9rem;
    }

    .field-result-lead--rail {
      padding-top: 0.95rem;
    }

    .field-result-lead--rail .field-result-corner {
      display: none;
    }

    .field-result-lead--rail .field-result-kicker {
      opacity: 1;
      height: auto;
      overflow: visible;
    }
  }
</style>
