---
import {
  buildMythmechLead,
  buildMythmechSupport,
  mergeMythmechMarginaliaEntries,
  normalizePlatePrompt,
  summarizeMythmech,
} from '../../lib/mythmech';
import { buildRespawnLead, parseRespawnSummary } from '../../lib/respawn';

const {
  title,
  objectUrl,
  packet,
  mythmech,
  platePrompt,
  marginaliaEntries = [],
  sourceText,
  respawn,
} = Astro.props as {
  title: string;
  objectUrl: string;
  packet: unknown | null;
  mythmech: unknown | null;
  platePrompt: string | null;
  marginaliaEntries?: unknown[];
  sourceText: string;
  respawn: string | null;
};

function asRecord(value: unknown): Record<string, unknown> | null {
  return value && typeof value === 'object' && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : null;
}

function asString(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function asNumber(value: unknown): number | null {
  return typeof value === 'number' && Number.isFinite(value) ? value : null;
}

function asStringList(value: unknown): string[] {
  return Array.isArray(value) ? value.map((item) => asString(item)).filter(Boolean) : [];
}

function joinParts(parts: string[], separator = ' / '): string {
  return parts.filter(Boolean).join(separator);
}

function uniqueStrings(values: string[]): string[] {
  return [...new Set(values.map((value) => value.trim()).filter(Boolean))];
}

function normalizeSignalTrack(value: unknown): string {
  const normalized = asString(value);
  return normalized.toUpperCase() === 'UNLOCKED SIGNAL' ? '' : normalized;
}

const packetData = asRecord(packet);
const mythmechData = mergeMythmechMarginaliaEntries(mythmech, marginaliaEntries);
const mythmechSummary = summarizeMythmech(mythmechData);
const mythmechLead = mythmechSummary ? buildMythmechLead(mythmechSummary) : '';
const mythmechSupport = mythmechSummary ? buildMythmechSupport(mythmechSummary) : '';
const artifact = asRecord(packetData?.artifact);
const signal = asRecord(packetData?.signal);
const atmosphere = asRecord(packetData?.atmosphere);
const traumaWeather = asRecord(packetData?.trauma_weather);
const shadow = asRecord(packetData?.shadow);

const packetId = asString(artifact?.id);
const packetClass = asString(artifact?.class);
const fieldLabel = joinParts([asString(artifact?.sector), asString(artifact?.region)]);
const trackLabel = normalizeSignalTrack(signal?.track);
const signalArtists = asStringList(signal?.artists);
const artistLabel = joinParts(signalArtists, ', ');
const hasSignal = Boolean(trackLabel) || signalArtists.length > 0;
const uiMode = asString(packetData?._ui_mode) || 'ENHANCED';
const modeLabel = asString(packetData?.mode);
const signalMode = asString(signal?.mode);
const coherenceValue = asNumber(signal?.coherence);
const bpmValue = asNumber(signal?.bpm);
const atmosphereLabel = joinParts([
  asString(atmosphere?.saturation_class) || asString(atmosphere?.pollen),
  asString(atmosphere?.intake_risk),
]);
const watchLabel = asString(traumaWeather?.alert) || 'NONE';
const shadowLabel = joinParts([
  asString(shadow?.offset) || 'NONE',
  asString(shadow?.desynchronization) || 'CLEAR',
]);

const packetNotes = Array.isArray(packetData?.notes)
  ? packetData.notes
      .map((item) => asRecord(item))
      .filter((item): item is Record<string, unknown> => Boolean(item))
      .map((item) => ({
        label: asString(item.label) || 'Note',
        value: asString(item.value),
      }))
      .filter((item) => item.value)
      .slice(0, 4)
  : [];

const normalizedSourceText = sourceText.trim();
const normalizedRespawn = typeof respawn === 'string' && respawn.trim() ? respawn.trim() : '';
const normalizedPlatePrompt = normalizePlatePrompt(platePrompt) || '';
const objectSlug = objectUrl.split('/').filter(Boolean).pop() || '';
const hudRoute = objectSlug ? `/codex/${encodeURIComponent(objectSlug)}/hud` : '#hud';
const respawnEntries = parseRespawnSummary(normalizedRespawn);
const respawnLead = buildRespawnLead(respawnEntries);
const objectPathLabel = objectUrl;
const noPacketMessage = mythmechSummary
  ? 'No packet sidecar is stored for this object yet. Mythmech remains attached as the active inspection lens.'
  : 'No packet sidecar is stored for this object yet. The source fragment remains canonical and this surface will fill in as soon as a packet is present.';
const mythmechLoadCopy = mythmechSummary
  ? uniqueStrings([
      mythmechSummary.criticalCount > 0 ? `${mythmechSummary.criticalCount} critical` : '',
      mythmechSummary.highCount > 0 ? `${mythmechSummary.highCount} high` : '',
      mythmechSummary.mediumCount > 0 ? `${mythmechSummary.mediumCount} medium` : '',
      mythmechSummary.lowCount > 0 ? `${mythmechSummary.lowCount} low` : '',
    ]).join(' / ')
  : '';
const mythmechLineageCopy = mythmechSummary
  ? mythmechSummary.parentCount > 0 || mythmechSummary.childCount > 0 || mythmechSummary.relationCount > 0
    ? `${mythmechSummary.parentCount} parents · ${mythmechSummary.childCount} children · ${mythmechSummary.relationCount} relations`
    : ''
  : '';
const mythmechFlowCopy = mythmechSummary
  ? mythmechSummary.flowLabels.length > 0
    ? `${mythmechSummary.flowCount} flows · ${mythmechSummary.flowLabels.join(' · ')}`
    : mythmechSummary.flowCount > 0
      ? `${mythmechSummary.flowCount} flows`
      : ''
  : '';
const mythmechSignalCopy = mythmechSummary
  ? mythmechSummary.marginaliaSignals.length > 0
    ? mythmechSummary.marginaliaSignals.join(' · ')
    : mythmechSummary.marginaliaTypes.length > 0
      ? mythmechSummary.marginaliaTypes.join(' · ')
      : ''
  : '';
const hasMythmechDetailGrid = Boolean(
  mythmechSummary &&
    (Boolean(mythmechSummary.hingeLabel) ||
      Boolean(mythmechLoadCopy) ||
      Boolean(mythmechFlowCopy) ||
      mythmechSummary.stateCount > 0 ||
      mythmechSummary.spawnCandidateCount > 0 ||
      Boolean(mythmechSignalCopy) ||
      mythmechSummary.marginaliaCount > 0)
);

const surfaceStates = uniqueStrings([
  packetData ? 'Packet-backed' : mythmechSummary ? 'Mythmech-backed' : 'Source-first',
  packetId ? 'Stored snapshot' : mythmechSummary ? 'Inspection lens attached' : 'Awaiting packet',
  hasSignal ? 'Signal-led' : mythmechSummary ? 'Structural read' : 'Open fragment',
  normalizedPlatePrompt ? 'Plate prompt stored' : '',
]);
const hudSurfaceState =
  packetData && mythmechSummary
    ? 'Packet + Mythmech'
    : mythmechSummary
      ? 'Mythmech Lens'
      : packetData
        ? 'Packet Memory'
        : 'Source First';
const hudSurfaceCopy = mythmechSummary
  ? 'One surface for hinge, load, packet memory, and return paths without crowding the object.'
  : packetData
    ? 'One surface for packet state, signal weather, and the preserved fragment.'
    : 'One surface for source continuity while the deeper structural layer comes online.';

const packetReportCards = [
  {
    label: 'Field',
    value: fieldLabel || 'Field position not stored',
  },
  {
    label: 'Atmosphere',
    value: atmosphereLabel || 'Atmosphere not stored',
  },
  {
    label: 'State',
    value: joinParts([modeLabel, watchLabel, shadowLabel], ' · ') || 'State not stored',
  },
];

const mythmechReportCards = mythmechSummary
  ? [
      {
        label: 'Inspection',
        value: mythmechLead,
      },
      {
        label: 'Hinge',
        value: mythmechSummary.hingeLabel || 'Hinge not stored',
      },
      {
        label: 'Load',
        value: mythmechLoadCopy || 'Load not stored',
      },
      {
        label: 'Lineage',
        value: mythmechLineageCopy || 'Lineage not stored',
      },
      {
        label: 'Spawn',
        value:
          mythmechSummary.spawnCandidateCount > 0
            ? mythmechSummary.candidateLabels.length > 0
              ? mythmechSummary.candidateLabels.join(' · ')
              : `${mythmechSummary.spawnCandidateCount} candidates`
            : 'Spawn not stored',
      },
      {
        label: 'Marginalia',
        value:
          mythmechSignalCopy ||
          (mythmechSummary.marginaliaCount > 0 ? `${mythmechSummary.marginaliaCount} signals stored` : 'Signals not stored'),
      },
    ]
  : [];

const reportCards = [...(packetData ? packetReportCards : []), ...mythmechReportCards].filter((card) => card.value);

const hudCards = [
  ...(packetData
    ? [
        { label: 'Packet', value: packetId || 'No packet stored' },
        { label: 'Class', value: packetClass || '—' },
        { label: 'Field', value: fieldLabel || '—' },
        { label: 'Signal Mode', value: signalMode || '' },
        { label: 'Atmosphere', value: atmosphereLabel || '—' },
        { label: 'Watch', value: watchLabel },
        { label: 'Shadow', value: shadowLabel },
      ]
    : []),
  ...(mythmechSummary
    ? [
        { label: 'Lens', value: mythmechSummary.enabled ? 'Enabled' : 'Stored' },
        { label: 'Hinge', value: mythmechSummary.hingeLabel || '' },
        { label: 'Nodes', value: String(mythmechSummary.nodeCount) },
        { label: 'Flows', value: String(mythmechSummary.flowCount) },
        { label: 'Load', value: mythmechLoadCopy || '' },
        { label: 'States', value: String(mythmechSummary.stateCount) },
        { label: 'Parents', value: String(mythmechSummary.parentCount) },
        { label: 'Children', value: String(mythmechSummary.childCount) },
        { label: 'Spawn', value: String(mythmechSummary.spawnCandidateCount) },
        { label: 'Marginalia', value: mythmechSignalCopy || String(mythmechSummary.marginaliaCount) },
      ]
    : []),
  { label: 'Object Path', value: objectPathLabel },
].filter((card) => card.value);

const signalMeta = [
  { label: 'Mode', value: signalMode || modeLabel },
  { label: 'BPM', value: bpmValue !== null ? String(bpmValue) : '' },
  { label: 'Coherence', value: coherenceValue !== null ? String(coherenceValue) : '' },
].filter((item) => item.value);
---

<section class="field-surface-wrap">
  <article class="field-surface-shell page-plate">
    <header class="field-surface-mast">
      <div class="field-surface-ident">
        <div class="field-surface-heading">
          <p class="field-surface-kicker">HUD</p>
          <h1 class="field-surface-title">{title}</h1>
        </div>
        <div class="field-surface-status-row" aria-label="Surface state">
          {surfaceStates.map((state) => (
            <span class="field-surface-status-pill">{state}</span>
          ))}
        </div>
      </div>

      <div class="field-surface-nav-block">
        <div class="field-surface-nav-card">
          <div class="field-surface-nav-header">
            <div class="field-surface-nav-copy-block">
              <p class="field-surface-nav-kicker">Visual Report</p>
              <p class="field-surface-nav-copy">{hudSurfaceCopy}</p>
            </div>
            <span class="field-surface-nav-state">{hudSurfaceState}</span>
          </div>
          <div class="field-surface-nav-actions" aria-label="Surface navigation">
            <a class="field-surface-return-link" href={objectUrl}>
              <span>Return</span>
              <strong>← Object</strong>
            </a>
            <a class="field-surface-mode-chip" href={hudRoute} aria-current="page">HUD</a>
          </div>
          <nav class="field-surface-anchor-links" aria-label="Section navigation">
            <a class="field-surface-anchor-pill" href="#hud">
              <span class="field-surface-anchor-index">01</span>
              <span>Overview</span>
            </a>
            <a class="field-surface-anchor-pill" href="#readout">
              <span class="field-surface-anchor-index">02</span>
              <span>Readout</span>
            </a>
          </nav>
          <div class="field-surface-path-block">
            <p class="field-surface-path">Canonical object</p>
            <a class="field-surface-path-link" href={objectUrl}>
              <span class="field-surface-path-value">{objectPathLabel}</span>
              <span class="field-surface-path-hint">Open the primary object</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    {hasSignal && (
      <section class="field-surface-signal-strip" aria-label="Signal ident">
        <div class="field-surface-signal-band" data-signal-mode={uiMode}>
          <div class="field-surface-signal-core">
            <div class="field-surface-eq" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <div>
              <p class="field-surface-micro">Signal Ident</p>
              {trackLabel && <p class="field-surface-track">{trackLabel}</p>}
              {artistLabel && <p class="field-surface-artists">{artistLabel}</p>}
              {uiMode === 'SIMPLE' && signalMode && <p class="field-surface-mode-line">{signalMode}</p>}
            </div>
          </div>

          {uiMode !== 'SIMPLE' && signalMeta.length > 0 && (
            <dl class="field-surface-mini">
              {signalMeta.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )}

    <section class="field-surface-section" id="hud">
      <div class="field-surface-section-kicker">HUD Overview</div>
      <div class="field-surface-hud-grid">
        {hudCards.map((card) => (
          <article class="field-surface-cell">
            <div class="field-surface-micro">{card.label}</div>
            <div class="field-surface-value">{card.value}</div>
          </article>
        ))}
      </div>

      {!packetData && (
        <p class="field-surface-empty">{noPacketMessage}</p>
      )}
    </section>

    <section class="field-surface-section" id="readout">
      <div class="field-surface-section-kicker">HUD Readout</div>
      {reportCards.length > 0 ? (
        <div class="field-surface-report-grid">
          {reportCards.map((card) => (
            <article class="field-surface-cluster">
              <p class="field-surface-cluster-label">{card.label}</p>
              <p class="field-surface-cluster-copy">{card.value}</p>
            </article>
          ))}
        </div>
      ) : (
        <p class="field-surface-empty">No packet or Mythmech readout cards are stored for this object yet.</p>
      )}

      <pre class="field-surface-fragment">{normalizedSourceText || 'No source text is available for this object.'}</pre>

      {(normalizedRespawn || packetNotes.length > 0 || mythmechSummary || normalizedPlatePrompt) && (
        <div class="field-surface-note-stack">
          {normalizedRespawn && (
            <article class="field-surface-note-card field-surface-note-card--respawn">
              <p class="field-surface-note-label">Respawn</p>
              {respawnLead && <p class="field-surface-note-title">{respawnLead}</p>}
              {respawnEntries.length > 0 && (
                <dl class="field-surface-note-grid">
                  {respawnEntries.map((entry) => (
                    <div class:list={['field-surface-note-stat', entry.key === 'NOTES' && 'field-surface-note-stat--wide']}>
                      <dt>{entry.label}</dt>
                      <dd>{entry.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </article>
          )}

          {mythmechSummary && (
            <article class="field-surface-note-card">
              <p class="field-surface-note-label">Mythmech</p>
              {mythmechLead && <p class="field-surface-note-title">{mythmechLead}</p>}
              {mythmechSupport && <p class="field-surface-note-copy">{mythmechSupport}</p>}
              {hasMythmechDetailGrid && (
                <dl class="field-surface-note-grid">
                  {mythmechSummary.stateCount > 0 && (
                    <div class="field-surface-note-stat">
                      <dt>States</dt>
                      <dd>{mythmechSummary.stateLabels.join(' · ')}</dd>
                    </div>
                  )}
                  {mythmechSummary.hingeLabel && (
                    <div class="field-surface-note-stat">
                      <dt>Hinge</dt>
                      <dd>{mythmechSummary.hingeLabel}</dd>
                    </div>
                  )}
                  {mythmechLoadCopy && (
                    <div class="field-surface-note-stat">
                      <dt>Load</dt>
                      <dd>{mythmechLoadCopy}</dd>
                    </div>
                  )}
                  {mythmechFlowCopy && (
                    <div class="field-surface-note-stat">
                      <dt>Flows</dt>
                      <dd>{mythmechFlowCopy}</dd>
                    </div>
                  )}
                  {mythmechLineageCopy && (
                    <div class="field-surface-note-stat">
                      <dt>Lineage</dt>
                      <dd>{mythmechLineageCopy}</dd>
                    </div>
                  )}
                  {mythmechSummary.spawnCandidateCount > 0 && (
                    <div class="field-surface-note-stat">
                      <dt>Spawn</dt>
                      <dd>
                        {mythmechSummary.candidateLabels.length > 0
                          ? mythmechSummary.candidateLabels.join(' · ')
                          : `${mythmechSummary.spawnCandidateCount} candidates`}
                      </dd>
                    </div>
                  )}
                  {(mythmechSignalCopy || mythmechSummary.marginaliaCount > 0) && (
                    <div class:list={['field-surface-note-stat', 'field-surface-note-stat--wide']}>
                      <dt>Marginalia Signals</dt>
                      <dd>
                        {mythmechSignalCopy || `${mythmechSummary.marginaliaCount} entries`}
                      </dd>
                    </div>
                  )}
                </dl>
              )}
            </article>
          )}

          {normalizedPlatePrompt && (
            <article class="field-surface-note-card">
              <p class="field-surface-note-label">Surface Prompt</p>
              <p class="field-surface-note-copy">{normalizedPlatePrompt}</p>
            </article>
          )}

          {packetNotes.map((note) => (
            <article class="field-surface-note-card">
              <p class="field-surface-note-label">{note.label}</p>
              <p class="field-surface-note-copy">{note.value}</p>
            </article>
          ))}
        </div>
      )}
    </section>
  </article>
</section>

<style>
  .field-surface-wrap {
    width: min(100%, 1120px);
    margin: clamp(2.2rem, 4vw, 3.8rem) auto 4rem;
    color: var(--field-amber-em);
  }

  .field-surface-shell {
    --plate-border: rgba(212, 196, 160, 0.16);
    --plate-shadow: 0 22px 56px rgba(0, 0, 0, 0.28);
    --plate-surface: linear-gradient(180deg, rgba(18, 14, 10, 0.985), rgba(11, 9, 6, 0.995));
    --plate-tint: rgba(201, 161, 90, 0.09);
    --plate-tint-secondary: rgba(212, 196, 160, 0.06);
    --plate-sheen: rgba(255, 255, 255, 0.04);
    --plate-ridge: rgba(255, 255, 255, 0.03);
    position: relative;
    overflow: hidden;
    padding: clamp(1.2rem, 2.4vw, 1.7rem);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent 18%),
      radial-gradient(circle at 14% 0%, rgba(201, 161, 90, 0.08), transparent 42%),
      radial-gradient(circle at 100% 100%, rgba(212, 196, 160, 0.06), transparent 58%),
      var(--field-bg);
  }

  .field-surface-shell::before,
  .field-surface-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .field-surface-shell::before {
    background: var(--field-scanlines);
    opacity: 0.28;
  }

  .field-surface-shell::after {
    background-image: var(--field-noise-image);
    background-size: 240px 240px;
    opacity: 0.03;
  }

  .field-surface-mast,
  .field-surface-signal-strip,
  .field-surface-section {
    position: relative;
    z-index: 1;
  }

  .field-surface-mast {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    align-items: start;
    gap: 1.6rem 2.2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--field-rule);
  }

  .field-surface-ident {
    min-width: 0;
    display: grid;
    gap: 1rem;
    max-width: 100%;
  }

  .field-surface-heading {
    max-width: 19ch;
  }

  .field-surface-kicker,
  .field-surface-status-pill,
  .field-surface-nav-kicker,
  .field-surface-nav-state,
  .field-surface-section-kicker,
  .field-surface-micro,
  .field-surface-mini dt,
  .field-surface-note-label,
  .field-surface-path,
  .field-surface-cluster-label,
  .field-surface-return-link span,
  .field-surface-anchor-index,
  .field-surface-path-hint {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .field-surface-kicker,
  .field-surface-nav-kicker,
  .field-surface-micro,
  .field-surface-mini dt,
  .field-surface-note-label,
  .field-surface-cluster-label,
  .field-surface-path,
  .field-surface-path-hint,
  .field-surface-anchor-index,
  .field-surface-return-link span {
    color: var(--field-amber-label);
  }

  .field-surface-title {
    margin: 0.48rem 0 0;
    color: var(--field-amber-em);
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 2rem + 1.35vw, 3.5rem);
    font-weight: 600;
    line-height: 0.96;
    text-wrap: balance;
  }

  .field-surface-status-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
    margin-top: 0;
    max-width: 32rem;
  }

  .field-surface-status-pill {
    padding: 0.22rem 0.54rem;
    border: 1px solid rgba(212, 196, 160, 0.18);
    border-radius: 999px;
    color: var(--field-amber-label);
    background: rgba(255, 255, 255, 0.015);
  }

  .field-surface-nav-block {
    min-width: 0;
    align-self: stretch;
  }

  .field-surface-nav-card {
    position: relative;
    display: grid;
    gap: 0.95rem;
    padding: 1.05rem;
    border: 1px solid rgba(212, 196, 160, 0.18);
    border-radius: 12px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.012)),
      radial-gradient(circle at 100% 0%, rgba(201, 161, 90, 0.09), transparent 46%),
      rgba(255, 255, 255, 0.02);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 18px 40px rgba(0, 0, 0, 0.18);
  }

  .field-surface-nav-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.03), transparent 44%),
      repeating-linear-gradient(
        90deg,
        rgba(201, 161, 90, 0.022) 0,
        rgba(201, 161, 90, 0.022) 1px,
        transparent 1px,
        transparent 12px
      );
    opacity: 0.82;
  }

  .field-surface-nav-card > * {
    position: relative;
    z-index: 1;
  }

  .field-surface-nav-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.9rem;
  }

  .field-surface-nav-copy-block {
    display: grid;
    gap: 0.42rem;
  }

  .field-surface-nav-kicker,
  .field-surface-nav-state {
    margin: 0;
  }

  .field-surface-nav-copy {
    margin: 0;
    color: var(--field-text-body);
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.58;
    text-wrap: balance;
  }

  .field-surface-nav-state {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.16rem 0.68rem;
    border: 1px solid rgba(201, 161, 90, 0.22);
    border-radius: 999px;
    color: var(--field-amber-accent);
    background: rgba(255, 255, 255, 0.03);
    white-space: nowrap;
  }

  .field-surface-nav-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.72rem;
    align-items: stretch;
