  .field-surface-snapshot-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .field-surface-snapshot-row dd {
    margin: 0;
    color: var(--field-amber-em);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
