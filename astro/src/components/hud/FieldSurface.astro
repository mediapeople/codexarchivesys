    letter-spacing: 0.08em;
    line-height: 1.38;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .field-surface-flow-arrow {
    position: absolute;
    top: 0.94rem;
    right: -0.2rem;
    color: var(--field-amber-label);
    font-family: var(--font-ui);
    font-size: 0.94rem;
    transform: translateX(50%);
    pointer-events: none;
