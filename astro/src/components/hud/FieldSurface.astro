  .field-surface-path-link {
    display: grid;
    gap: 0.36rem;
    padding: 0.82rem 0.88rem;
    border: 1px solid var(--surface-line);
    background: var(--surface-panel-wash);
  }

  .field-surface-path-value {
    color: var(--field-text-body);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    line-height: 1.56;
    overflow-wrap: anywhere;
  }

  .field-surface-strike-wrap {
    margin-top: 1.55rem;
