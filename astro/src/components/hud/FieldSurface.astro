  .field-surface-view-panel {
    margin-top: 1.5rem;
  }

  .field-surface-section--views {
    padding-left: 0;
    padding-right: 0;
    border: 0;
    border-top: 1px solid var(--surface-line);
    border-radius: 0;
    background: none;
    box-shadow: none;
