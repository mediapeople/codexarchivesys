    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.72;
    text-wrap: pretty;
    max-width: 34rem;
  }

  .field-surface-anchor-support {
    color: var(--field-amber-dim);
    font-size: 0.96rem;
    max-width: 30rem;
  }

  .field-surface-hinge-block {
    margin-top: 0.96rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 18rem);
    gap: 1rem 1.5rem;
    align-items: start;
  }

  .field-surface-hinge-title {
    margin: 0;
    color: var(--field-amber-em);
    font-family: var(--font-ui);
    font-size: clamp(1.18rem, 1.06rem + 0.38vw, 1.48rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1.14;
    text-transform: uppercase;
  }

  .field-surface-hinge-summary,
  .field-surface-hinge-note {
    margin: 0.64rem 0 0;
