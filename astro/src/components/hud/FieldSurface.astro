    border-radius: var(--surface-radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.008)),
      rgba(10, 9, 7, 0.82);
    box-shadow: inset 0 1px 0 var(--surface-panel-line);
  }

  .field-surface-anchor-title {
    margin: 0;
    color: var(--field-amber-em);
    font-family: var(--font-ui);
    font-size: clamp(1.08rem, 1rem + 0.46vw, 1.44rem);
