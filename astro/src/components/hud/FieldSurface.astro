    display: grid;
    gap: 0.24rem;
  }

  .field-surface-rail-row dt,
  .field-surface-rail-row dd {
    min-width: 0;
  }

  .field-surface-rail-row dd {
    margin: 0;
    color: var(--field-amber-em);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.74;
    overflow-wrap: anywhere;
  }

  .field-surface-rail-list--diagnostic .field-surface-rail-row dt {
    color: var(--field-amber-label);
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
