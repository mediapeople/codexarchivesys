    border-radius: var(--surface-chip-radius);
    color: var(--field-amber-label);
    background: var(--surface-panel-wash);
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background 140ms ease,
      transform 140ms ease;
  }

  .field-surface-view-button:hover,
  .field-surface-view-button.is-active {
    color: var(--field-amber-em);
    border-color: var(--surface-accent-line);
    background: var(--surface-accent-fill);
    transform: translateY(-1px);
