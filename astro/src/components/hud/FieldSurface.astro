    color: var(--field-amber-em);
  }

  .field-surface-heading {
    max-width: min(100%, 31rem);
  }

  .field-surface-kicker,
  .field-surface-status-pill,
  .field-surface-nav-kicker,
  .field-surface-nav-state,
  .field-surface-section-kicker,
  .field-surface-micro,
  .field-surface-mini dt,
  .field-surface-note-label,
  .field-surface-path,
  .field-surface-cluster-label,
  .field-surface-anchor-index,
  .field-surface-path-hint {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .field-surface-kicker,
  .field-surface-nav-kicker,
  .field-surface-micro,
  .field-surface-mini dt,
  .field-surface-note-label,
  .field-surface-cluster-label,
  .field-surface-path,
  .field-surface-path-hint,
  .field-surface-anchor-index {
