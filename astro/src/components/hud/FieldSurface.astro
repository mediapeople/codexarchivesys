  .field-surface-nav-copy {
    margin: 0;
    color: var(--field-text-body);
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.58;
    text-wrap: balance;
  }

  .field-surface-nav-state {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    padding: 0.16rem 0.68rem;
    border: 1px solid var(--surface-line);
    border-radius: var(--surface-chip-radius);
    color: var(--field-amber-label);
    background: var(--surface-panel-wash);
