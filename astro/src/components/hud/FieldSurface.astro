  .field-surface-hinge-label,
  .field-surface-flow-card-label,
  .field-surface-snapshot-row dt,
  .field-surface-view-button {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .field-surface-hinge-label,
  .field-surface-flow-card-label,
  .field-surface-snapshot-row dt {
    margin: 0;
    color: var(--field-amber-label);
