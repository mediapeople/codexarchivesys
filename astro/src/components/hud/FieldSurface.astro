  .field-surface-nav-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.9rem;
  }

  .field-surface-nav-copy-block {
    display: grid;
    gap: 0.42rem;
  }

  .field-surface-nav-kicker,
