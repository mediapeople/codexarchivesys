  .field-surface-visual-meta {
    margin-top: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem 0.72rem;
    color: var(--field-amber-label);
    font-family: var(--font-ui);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .field-surface-visual-meta span + span::before {
    content: '/';
    margin-right: 0.62rem;
    color: var(--field-text-dim);
