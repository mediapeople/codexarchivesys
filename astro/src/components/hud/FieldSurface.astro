---
import {
  buildMythmechLead,
  buildMythmechSupport,
  extractMythmechInspectModel,
  mergeMythmechMarginaliaEntries,
  normalizePlatePrompt,
  summarizeMythmech,
} from '../../lib/mythmech';
import { buildRespawnLead, parseRespawnSummary } from '../../lib/respawn';

const {
  title,
  objectUrl,
  packet,
  mythmech,
  platePrompt,
  hudVisual = null,
  marginaliaEntries = [],
  sourceText = '',
  respawn,
} = Astro.props as {
  title: string;
  objectUrl: string;
  packet: unknown | null;
  mythmech: unknown | null;
  platePrompt: string | null;
  hudVisual?: {
    kind: 'image' | 'video';
    src: string;
    alt?: string;
    caption?: string;
    role?: string;
    width?: number | null;
    height?: number | null;
    shape?: string;
  } | null;
  marginaliaEntries?: unknown[];
  sourceText?: string;
  respawn: string | null;
};

function asRecord(value: unknown): Record<string, unknown> | null {
  return value && typeof value === 'object' && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : null;
}

function asString(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function asNumber(value: unknown): number | null {
  return typeof value === 'number' && Number.isFinite(value) ? value : null;
}

function asStringList(value: unknown): string[] {
  return Array.isArray(value) ? value.map((item) => asString(item)).filter(Boolean) : [];
}

function joinParts(parts: string[], separator = ' / '): string {
  return parts.filter(Boolean).join(separator);
}

function uniqueStrings(values: string[], max?: number): string[] {
  const unique = [...new Set(values.map((value) => value.trim()).filter(Boolean))];
  return typeof max === 'number' ? unique.slice(0, max) : unique;
}

function normalizeSignalTrack(value: unknown): string {
  const normalized = asString(value);
  return normalized.toUpperCase() === 'UNLOCKED SIGNAL' ? '' : normalized;
}

type SurfaceLoadLevel = 'critical' | 'high' | 'medium' | 'low' | '';

type SurfaceChamber = {
  id: string;
  label: string;
  shortLabel: string;
  role: string;
  load: SurfaceLoadLevel;
  source: 'mythmech' | 'packet';
  summary: string;
  detail: string;
};

type SurfaceConnector = {
  id: string;
  from: string;
  to: string;
  label: string;
  flow: string;
};

type StagePoint = {
  x: number;
  y: number;
};

function compactLabel(value: string, words = 4): string {
  const parts = value.trim().split(/\s+/).filter(Boolean);
  return parts.slice(0, words).join(' ');
}

function commandLabel(value: string, words = 3): string {
  return compactLabel(value.replace(/[^\p{L}\p{N}/ -]+/gu, ' '), words).toUpperCase() || 'STATE ACTIVE';
}

function sentenceCase(value: string): string {
  const normalized = value.trim();
  if (!normalized) {
    return '';
  }

  return /[.?!]$/.test(normalized) ? normalized : `${normalized}.`;
}

function clipCopy(value: string, max = 180): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (!normalized || normalized.length <= max) {
    return normalized;
  }

  return `${normalized.slice(0, max).replace(/\s+\S*$/, '').replace(/[.?!,:;]+$/, '').trim()}...`;
}

function normalizeCompareCopy(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

function copiesAreRedundant(primary: string, secondary: string): boolean {
  const a = normalizeCompareCopy(primary);
  const b = normalizeCompareCopy(secondary);
  if (!a || !b) {
    return false;
  }

  return a === b || a.includes(b) || b.includes(a);
}

function collapseCopies(primary: string, secondary: string): { primary: string; secondary: string } {
  const first = primary.trim();
  const second = secondary.trim();

  if (!first) {
    return { primary: second, secondary: '' };
  }

  if (!second || copiesAreRedundant(first, second)) {
    return { primary: first, secondary: '' };
  }

  return { primary: first, secondary: second };
}

function buildFragmentPreview(value: string, maxLines = 18, maxChars = 1400): string {
  const normalized = value.trim();
  if (!normalized) {
    return '';
  }

  const lines = normalized.split('\n');
  const previewLines = lines.slice(0, maxLines);
  let preview = previewLines.join('\n').trimEnd();

  if (preview.length > maxChars) {
    preview = `${preview.slice(0, maxChars).replace(/\s+\S*$/, '').trimEnd()}\n…`;
  } else if (lines.length > maxLines) {
    preview = `${preview}\n…`;
  }

  return preview;
}

function normalizeFlowTone(value: string): 'pressure' | 'control' | 'grounding' | 'signal' {
  const normalized = value.toLowerCase();
  if (normalized.includes('control') || normalized.includes('adjust')) return 'control';
  if (
    normalized.includes('ground') ||
    normalized.includes('relation') ||
    normalized.includes('anchor') ||
    normalized.includes('link')
  ) {
    return 'grounding';
  }

  if (normalized.includes('pressure') || normalized.includes('risk') || normalized.includes('fail')) return 'pressure';
  return 'signal';
}

function buildStagePoints(count: number): StagePoint[] {
  const layouts: Record<number, StagePoint[]> = {
    1: [{ x: 48, y: 20 }],
    2: [{ x: 48, y: 18 }, { x: 74, y: 56 }],
    3: [{ x: 48, y: 16 }, { x: 22, y: 54 }, { x: 74, y: 58 }],
    4: [{ x: 46, y: 14 }, { x: 76, y: 24 }, { x: 24, y: 54 }, { x: 64, y: 66 }],
    5: [{ x: 46, y: 14 }, { x: 76, y: 24 }, { x: 18, y: 30 }, { x: 30, y: 62 }, { x: 70, y: 62 }],
    6: [{ x: 44, y: 14 }, { x: 76, y: 22 }, { x: 16, y: 28 }, { x: 28, y: 54 }, { x: 58, y: 48 }, { x: 78, y: 72 }],
    7: [{ x: 44, y: 14 }, { x: 76, y: 22 }, { x: 16, y: 28 }, { x: 28, y: 52 }, { x: 54, y: 46 }, { x: 78, y: 58 }, { x: 46, y: 78 }],
    8: [{ x: 44, y: 14 }, { x: 76, y: 22 }, { x: 16, y: 28 }, { x: 28, y: 48 }, { x: 56, y: 42 }, { x: 82, y: 50 }, { x: 34, y: 78 }, { x: 68, y: 76 }],
  };

  const fallback = layouts[Math.min(Math.max(count, 1), 8)] ?? layouts[8];
  return fallback.slice(0, count);
}

const packetData = asRecord(packet);
const mythmechData = mergeMythmechMarginaliaEntries(mythmech, marginaliaEntries);
const mythmechSummary = summarizeMythmech(mythmechData);
const mythmechLead = mythmechSummary ? buildMythmechLead(mythmechSummary) : '';
const mythmechSupport = mythmechSummary ? buildMythmechSupport(mythmechSummary) : '';
const mythmechInspectModel = extractMythmechInspectModel(mythmechData);
const artifact = asRecord(packetData?.artifact);
const signal = asRecord(packetData?.signal);
const atmosphere = asRecord(packetData?.atmosphere);
const traumaWeather = asRecord(packetData?.trauma_weather);
const shadow = asRecord(packetData?.shadow);

const packetId = asString(artifact?.id);
const packetClass = asString(artifact?.class);
const fieldLabel = joinParts([asString(artifact?.sector), asString(artifact?.region)]);
const trackLabel = normalizeSignalTrack(signal?.track);
const signalArtists = asStringList(signal?.artists);
const artistLabel = joinParts(signalArtists, ', ');
const hasSignal = Boolean(trackLabel) || signalArtists.length > 0;
const uiMode = asString(packetData?._ui_mode) || 'ENHANCED';
const modeLabel = asString(packetData?.mode);
const signalMode = asString(signal?.mode);
const coherenceValue = asNumber(signal?.coherence);
const bpmValue = asNumber(signal?.bpm);
const intakeRisk = asString(atmosphere?.intake_risk);
const atmosphereLabel = joinParts([
  asString(atmosphere?.saturation_class) || asString(atmosphere?.pollen),
  intakeRisk,
]);
const watchLabel = asString(traumaWeather?.alert) || 'NONE';
const shadowLabel = joinParts([
  asString(shadow?.offset) || 'NONE',
  asString(shadow?.desynchronization) || 'CLEAR',
]);

const packetNotes = Array.isArray(packetData?.notes)
  ? packetData.notes
      .map((item) => asRecord(item))
      .filter((item): item is Record<string, unknown> => Boolean(item))
      .map((item) => ({
        label: asString(item.label) || 'Note',
        value: asString(item.value),
      }))
      .filter((item) => item.value)
      .slice(0, 4)
  : [];

const normalizedSourceText = typeof sourceText === 'string' ? sourceText.trim() : '';
const normalizedRespawn = typeof respawn === 'string' && respawn.trim() ? respawn.trim() : '';
const normalizedPlatePrompt = normalizePlatePrompt(platePrompt) || '';
const objectSlug = objectUrl.split('/').filter(Boolean).pop() || '';
const respawnEntries = parseRespawnSummary(normalizedRespawn);
const respawnLead = buildRespawnLead(respawnEntries);
const objectPathLabel = objectUrl;
const noPacketMessage = mythmechSummary
  ? 'No field packet is attached yet. Mythmech remains the active inspection lens.'
  : 'No field packet is attached. This HUD is running in source-first mode, and packet memory can be added later if it earns the space.';
const mythmechLoadCopy = mythmechSummary
  ? uniqueStrings([
      mythmechSummary.criticalCount > 0 ? `${mythmechSummary.criticalCount} critical` : '',
      mythmechSummary.highCount > 0 ? `${mythmechSummary.highCount} high` : '',
      mythmechSummary.mediumCount > 0 ? `${mythmechSummary.mediumCount} medium` : '',
      mythmechSummary.lowCount > 0 ? `${mythmechSummary.lowCount} low` : '',
    ]).join(' / ')
  : '';
const mythmechLineageCopy = mythmechSummary
  ? mythmechSummary.parentCount > 0 || mythmechSummary.childCount > 0 || mythmechSummary.relationCount > 0
    ? `${mythmechSummary.parentCount} parents · ${mythmechSummary.childCount} children · ${mythmechSummary.relationCount} relations`
    : ''
  : '';
const mythmechFlowCopy = mythmechSummary
  ? mythmechSummary.flowLabels.length > 0
    ? `${mythmechSummary.flowCount} flows · ${mythmechSummary.flowLabels.join(' · ')}`
    : mythmechSummary.flowCount > 0
      ? `${mythmechSummary.flowCount} flows`
      : ''
  : '';
const mythmechSignalCopy = mythmechSummary
  ? mythmechSummary.marginaliaSignals.length > 0
    ? mythmechSummary.marginaliaSignals.join(' · ')
    : mythmechSummary.marginaliaTypes.length > 0
      ? mythmechSummary.marginaliaTypes.join(' · ')
      : ''
  : '';
const hasMythmechDetailGrid = Boolean(
  mythmechSummary &&
    (Boolean(mythmechSummary.hingeLabel) ||
      Boolean(mythmechLoadCopy) ||
      Boolean(mythmechFlowCopy) ||
      mythmechSummary.stateCount > 0 ||
      mythmechSummary.spawnCandidateCount > 0 ||
      Boolean(mythmechSignalCopy) ||
      mythmechSummary.marginaliaCount > 0)
);

const surfaceContextLine = uniqueStrings([
  packetData ? 'Built from packet memory' : mythmechSummary ? 'Built from Mythmech structure' : 'Running source-first',
  packetId ? 'using the stored snapshot' : mythmechSummary ? 'with an inspect lens attached' : '',
  hasSignal ? 'and current signal state' : normalizedPlatePrompt ? 'with a stored surface prompt' : '',
], 3).join(' / ');

const signalMeta = [
  { label: 'Mode', value: signalMode || modeLabel },
  { label: 'BPM', value: bpmValue !== null ? String(bpmValue) : '' },
  { label: 'Coherence', value: coherenceValue !== null ? String(coherenceValue) : '' },
].filter((item) => item.value);
const packetSignalLabel = joinParts([trackLabel, signalMode], ' / ');
const fallbackInspectChambers: SurfaceChamber[] = packetData
  ? [
      {
        id: 'hinge',
        label: packetNotes[0]?.value || 'Signal threshold',
        shortLabel: compactLabel(packetNotes[0]?.value || 'Signal threshold'),
        role: 'Hinge',
        load: 'critical',
        source: 'packet',
        summary: sentenceCase(packetNotes[0]?.value || 'Packet notes identify the main intervention point for this field.'),
        detail: sentenceCase(
          packetNotes[0]?.value ||
            'This packet-derived hinge becomes the first chamber in inspect mode until authored Mythmech arrives.'
        ),
      },
      {
        id: 'signal',
        label: packetSignalLabel || 'Signal',
        shortLabel: compactLabel(packetSignalLabel || 'Signal'),
        role: 'Signal',
        load: 'high',
        source: 'packet',
        summary: sentenceCase(
          packetSignalLabel ? `Signal track ${packetSignalLabel} is the stabilizing control surface.` : 'Signal state is stored in packet memory.'
        ),
        detail: sentenceCase(
          packetSignalLabel
            ? `${packetSignalLabel} carries the available agency in the current field state.`
            : 'Signal metadata will populate here when the packet is richer.'
        ),
      },
      {
        id: 'atmosphere',
        label: atmosphereLabel || 'Atmosphere',
        shortLabel: compactLabel(atmosphereLabel || 'Atmosphere'),
        role: 'Pressure',
        load: 'high',
        source: 'packet',
        summary: sentenceCase(
          atmosphereLabel ? `${atmosphereLabel} defines the environmental load on the object.` : 'Atmosphere data is stored in packet memory.'
        ),
        detail: sentenceCase(
          atmosphereLabel
            ? `${atmosphereLabel} is the pressure chamber acting on the object from outside the body.`
            : 'Atmosphere metadata will appear here once packet data is present.'
        ),
      },
      {
        id: 'field',
        label: fieldLabel || 'Field position',
        shortLabel: compactLabel(fieldLabel || 'Field position'),
        role: 'Ground',
        load: 'medium',
        source: 'packet',
        summary: sentenceCase(
          fieldLabel ? `${fieldLabel} grounds the scroll in a specific field position.` : 'Field position is stored in packet memory.'
        ),
        detail: sentenceCase(
          fieldLabel
            ? `${fieldLabel} is the chamber that keeps this reading attached to place, not abstraction.`
            : 'Field position will become visible here when packet metadata is available.'
        ),
      },
      {
        id: 'shadow',
        label: shadowLabel || 'Shadow',
        shortLabel: compactLabel(shadowLabel || 'Shadow'),
        role: 'Trace',
        load: 'medium',
        source: 'packet',
        summary: sentenceCase(
          shadowLabel ? `${shadowLabel} tracks drift, offset, and recurrence around the field.` : 'Shadow trace is stored in packet memory.'
        ),
        detail: sentenceCase(
          shadowLabel
            ? `${shadowLabel} is the chamber where desynchronization and afterimage begin to register.`
            : 'Shadow state will appear here when packet metadata is available.'
        ),
      },
      {
        id: 'state',
        label: joinParts([modeLabel, watchLabel], ' / ') || 'State',
        shortLabel: compactLabel(joinParts([modeLabel, watchLabel], ' / ') || 'State'),
        role: 'State',
        load: 'low',
        source: 'packet',
        summary: sentenceCase(
          modeLabel || watchLabel
            ? `${joinParts([modeLabel, watchLabel], ' / ')} records the current operating posture.`
            : 'Operating state is stored in packet memory.'
        ),
        detail: sentenceCase(
          modeLabel || watchLabel
            ? `${joinParts([modeLabel, watchLabel], ' / ')} is the visible posture presented by the system under load.`
            : 'State metadata will appear here when packet data is available.'
        ),
      },
    ].filter((item) => item.label)
  : [];
const fallbackInspectConnectors: SurfaceConnector[] =
  fallbackInspectChambers.length > 0
    ? [
        { id: 'field-atmosphere', from: 'field', to: 'atmosphere', label: 'Grounds', flow: 'Grounding' },
        { id: 'atmosphere-hinge', from: 'atmosphere', to: 'hinge', label: 'Pressurizes', flow: 'Pressure' },
        { id: 'signal-hinge', from: 'signal', to: 'hinge', label: 'Stabilizes', flow: 'Control' },
        { id: 'shadow-hinge', from: 'shadow', to: 'hinge', label: 'Echoes', flow: 'Pressure' },
        { id: 'hinge-state', from: 'hinge', to: 'state', label: 'Determines', flow: 'Control' },
      ].filter((item) =>
        fallbackInspectChambers.some((node) => node.id === item.from) &&
        fallbackInspectChambers.some((node) => node.id === item.to)
      )
    : [];
const inspectChambers: SurfaceChamber[] =
  mythmechInspectModel && mythmechInspectModel.nodes.length > 0
    ? mythmechInspectModel.nodes.map((node) => ({
        id: node.id,
        label: node.label,
        shortLabel: compactLabel(node.label),
        role: node.role,
        load: node.load,
        source: 'mythmech',
        summary: sentenceCase(node.summary),
        detail: sentenceCase(node.detail),
      }))
    : fallbackInspectChambers;
const inspectConnectors: SurfaceConnector[] =
  mythmechInspectModel && mythmechInspectModel.nodes.length > 0
    ? mythmechInspectModel.edges.map((edge) => ({
        id: edge.id,
        from: edge.from,
        to: edge.to,
        label: edge.label,
        flow: edge.flow,
      }))
    : fallbackInspectConnectors;
const inspectSourceLabel =
  mythmechInspectModel && mythmechInspectModel.nodes.length > 0
    ? 'Mythmech-authored structure'
    : packetData
      ? 'Packet-derived fallback'
      : '';
const inspectLeadLabel =
  mythmechInspectModel?.hingeLabel ||
  inspectChambers.find((node) => node.id === 'hinge')?.label ||
  inspectChambers[0]?.label ||
  title;
const inspectLeadCopy =
  mythmechLead ||
  packetNotes[0]?.value ||
  'Select a chamber to inspect what carries the object, how pressure moves, and where intervention begins.';
const inspectSupportCopy =
  mythmechSupport ||
  'Start at the hinge, then trace pressure, control, and grounding to understand what the piece is doing under load.';
const inspectIntro = collapseCopies(inspectLeadCopy, inspectSupportCopy);
const inspectLegend = [
  { label: 'Pressure', tone: 'pressure', copy: 'Constraint, risk, breakdown' },
  { label: 'Control', tone: 'control', copy: 'Adjustment, agency, response' },
  { label: 'Grounding', tone: 'grounding', copy: 'Relation, anchor, return' },
];
const inspectStagePoints = buildStagePoints(inspectChambers.length);
const inspectChamberPlacements = inspectChambers.map((node, index) => ({
  ...node,
  point: inspectStagePoints[index] ?? inspectStagePoints[inspectStagePoints.length - 1] ?? { x: 50, y: 50 },
}));
const inspectPointMap = new Map(inspectChamberPlacements.map((node) => [node.id, node.point]));
const inspectLabelMap = new Map(inspectChamberPlacements.map((node) => [node.id, node.label]));
const inspectResolvedConnectors = inspectConnectors
  .map((connector) => {
    const fromPoint = inspectPointMap.get(connector.from);
    const toPoint = inspectPointMap.get(connector.to);
    if (!fromPoint || !toPoint) {
      return null;
    }

    return {
      ...connector,
      tone: normalizeFlowTone(connector.flow || connector.label),
      fromPoint,
      toPoint,
    };
  })
  .filter(
    (
      connector
    ): connector is SurfaceConnector & { tone: 'pressure' | 'control' | 'grounding' | 'signal'; fromPoint: StagePoint; toPoint: StagePoint } =>
      Boolean(connector)
  );
const inspectProvenanceRefs = mythmechInspectModel
  ? uniqueStrings([...mythmechInspectModel.parentRefs, ...mythmechInspectModel.relationRefs], 4)
  : [];
const inspectSpawnRefs = mythmechInspectModel ? mythmechInspectModel.candidateRefs.slice(0, 3) : [];
const inspectReverseTrace = mythmechInspectModel?.reverseTrace ?? [];
const inspectInitialNodeId =
  (mythmechInspectModel?.hingeId &&
    inspectChamberPlacements.some((node) => node.id === mythmechInspectModel.hingeId) &&
    mythmechInspectModel.hingeId) ||
  inspectChamberPlacements[0]?.id ||
  '';
const inspectDetailCards = inspectChamberPlacements.map((node) => ({
  ...node,
  ...collapseCopies(node.summary, node.detail),
  flows: inspectResolvedConnectors
    .filter((connector) => connector.from === node.id || connector.to === node.id)
    .map((connector) => ({
      id: connector.id,
      direction: connector.from === node.id ? 'Out' : 'In',
      label: connector.label,
      target: connector.from === node.id ? inspectLabelMap.get(connector.to) || connector.to : inspectLabelMap.get(connector.from) || connector.from,
      tone: connector.tone,
    })),
  provenance:
    mythmechInspectModel && (node.id === mythmechInspectModel.hingeId || node.load === 'critical')
      ? inspectProvenanceRefs
      : [],
  spawn:
    mythmechInspectModel && (node.id === mythmechInspectModel.hingeId || node.load === 'critical')
      ? inspectSpawnRefs
      : [],
  reverseTrace:
    mythmechInspectModel && (node.id === mythmechInspectModel.hingeId || node.load === 'critical')
      ? inspectReverseTrace
      : [],
}));
const inspectRootId = objectSlug ? `inspect-stage-${objectSlug}` : 'inspect-stage';
const viewRootId = objectSlug ? `hud-view-${objectSlug}` : 'hud-view';

function findInspectValue(matchers: string[]): string {
  const node = inspectChambers.find((item) => {
    const role = item.role.toLowerCase();
    const label = item.label.toLowerCase();
    const id = item.id.toLowerCase();
    return matchers.some((matcher) => role.includes(matcher) || label.includes(matcher) || id.includes(matcher));
  });

  return node?.label || '';
}

const inspectPressureValue = findInspectValue(['pressure']) || atmosphereLabel || mythmechLoadCopy;
const inspectControlValue = findInspectValue(['signal', 'control']) || packetSignalLabel || signalMode || mythmechFlowCopy;
const inspectGroundValue = findInspectValue(['ground', 'field', 'anchor']) || fieldLabel;
const inspectStateValue =
  findInspectValue(['state', 'trace', 'shadow']) || joinParts([modeLabel, watchLabel, shadowLabel], ' · ');
const inspectContinuityValue =
  mythmechLineageCopy || (mythmechSummary ? `${mythmechSummary.nodeCount} nodes · ${mythmechSummary.flowCount} flows` : '');

const fieldStrikeValue = asString(artifact?.sector) || fieldLabel || (mythmechSummary ? 'STRUCTURE' : 'SOURCE');
const pressureStrikeValue =
  asString(atmosphere?.intake_risk).toUpperCase() ||
  asString(atmosphere?.saturation_class).toUpperCase() ||
  asString(atmosphere?.pollen).toUpperCase() ||
  mythmechLoadCopy.toUpperCase() ||
  (mythmechSummary ? 'INFERRED' : 'UNLOADED');
const signalStrikeCore = signalMode || trackLabel || inspectControlValue || (mythmechSummary ? 'STRUCTURED' : 'BODY FIRST');
const signalStrikeValue = coherenceValue !== null ? `${signalStrikeCore} ${coherenceValue}` : signalStrikeCore;
const stateStrikeValue = watchLabel || shadowLabel || (mythmechSummary ? 'INSPECTABLE' : 'READABLE');
const watchDisplay = watchLabel === 'WATCH' ? 'Active' : watchLabel || 'None';
const snapshotRows = [
  { label: 'Field', value: fieldLabel || fieldStrikeValue || 'Not stored' },
  { label: 'Atmosphere', value: atmosphereLabel || 'Not stored' },
  { label: 'Shadow', value: shadowLabel || 'None / Clear' },
  { label: 'Watch', value: watchDisplay },
];

const meaningLine =
  !packetData && !mythmechSummary
    ? 'Source fragment is ready.'
    : modeLabel === 'TARGET'
    ? 'Direction has resolved.'
    : modeLabel === 'SEALED'
      ? 'Containment is holding.'
      : watchLabel === 'WATCH'
        ? 'Attention needs to stay active.'
        : mythmechLead
          ? sentenceCase(clipCopy(mythmechLead, 86))
          : packetNotes[0]?.value
            ? sentenceCase(clipCopy(packetNotes[0].value, 86))
            : 'Packet state is available.';
const consequenceLine =
  !packetData && !mythmechSummary
    ? 'HUD can open without field load or packet memory.'
    : modeLabel === 'TARGET'
    ? 'The system is ready to act, not search.'
    : modeLabel === 'SEALED'
      ? 'The boundary is doing work, so avoid unnecessary disturbance.'
      : watchLabel === 'WATCH'
        ? 'This is not an emergency, but it is not a forgettable state.'
        : coherenceValue !== null && coherenceValue >= 60
          ? 'Conditions are coherent enough for motion, but not strong enough to ignore noise.'
          : atmosphereLabel
            ? 'Conditions are present, so read the field before you commit.'
            : 'Inspection clarifies what deserves attention.';
const attentionLine =
  !packetData && !mythmechSummary
    ? 'Start with the fragment and add structure only when it becomes useful.'
    : intakeRisk === 'CRITICAL' || intakeRisk === 'HIGH'
    ? 'Monitor intake and pressure drift before increasing load.'
    : watchLabel === 'WATCH'
      ? 'Maintain attention on drift, watch state, and signal coherence.'
      : shadowLabel && shadowLabel !== 'NONE / CLEAR'
        ? 'Keep an eye on hidden drag and desynchronization.'
        : 'Proceed, but inspect deeper if the state begins to shift.';
const nextMoveLine =
  !packetData && !mythmechSummary
    ? 'Use fragment now, then add graph or memory later if the object needs deeper instrumentation.'
    : modeLabel === 'TARGET'
    ? 'Continue forward and use graph or memory only if conditions change.'
    : watchLabel === 'WATCH'
      ? 'Stay with the object, then inspect the graph if you need more resolution.'
      : 'Use the depth views to inspect graph, fragment, or memory on demand.';
const hingeCommand =
  modeLabel === 'TARGET'
    ? 'TARGET LOCKED'
    : modeLabel === 'SEALED'
      ? 'SEALED HOLD'
      : watchLabel === 'WATCH'
        ? 'WATCH ACTIVE'
        : signalMode
          ? `${commandLabel(signalMode, 2)} SIGNAL`
          : commandLabel(inspectLeadLabel, 3);
const hingeSummary = uniqueStrings([meaningLine, consequenceLine]).join(' ');
const hasHudVisual = Boolean(hudVisual?.src);
const anchorSupportLine = hasHudVisual
  ? sentenceCase(clipCopy(hudVisual?.caption || inspectIntro.secondary || inspectLeadLabel, 132))
  : sentenceCase(clipCopy(inspectIntro.secondary || inspectLeadLabel, 132));
const flowVectorItems = [
  { label: 'Pressure', value: pressureStrikeValue || 'UNSCORED', direction: 'input' },
  { label: 'Signal', value: signalStrikeValue || 'UNSCORED', direction: 'stabilize' },
  { label: 'Action', value: modeLabel || commandLabel(inspectLeadLabel, 2), direction: 'output' },
];
const valueRegisterCards = [
  { label: 'Meaning', definition: 'What the current state says about this object.', value: meaningLine },
  { label: 'Consequence', definition: 'Why that state matters in this object right now.', value: consequenceLine },
  { label: 'Attention', definition: 'What this object is asking you to watch.', value: attentionLine },
  { label: 'Next Move', definition: 'The simplest useful move from this object state.', value: nextMoveLine },
];
const supportingCards = [
  packetId ? { label: 'Packet', definition: 'The stored field record attached to this object.', value: packetId } : null,
  packetClass ? { label: 'Class', definition: 'The archive class this object is carrying.', value: packetClass } : null,
  inspectContinuityValue ? { label: 'Lineage', definition: 'How this object connects to parent, child, or peer structure.', value: inspectContinuityValue } : null,
  mythmechSummary
    ? {
        label: 'Spawnable Vectors',
        definition: 'The live directions this object can continue into new objects.',
        value:
          mythmechSummary.spawnCandidateCount > 0
            ? mythmechSummary.candidateLabels.length > 0
              ? mythmechSummary.candidateLabels.join(' · ')
              : `${mythmechSummary.spawnCandidateCount} vectors`
            : 'No vectors stored',
      }
    : null,
  mythmechSummary
    ? {
        label: 'Marginalia Signals',
        definition: 'The notes and tags already shaping how this object is being read.',
        value:
          mythmechSignalCopy ||
          (mythmechSummary.marginaliaCount > 0 ? `${mythmechSummary.marginaliaCount} signals stored` : 'Signals not stored'),
      }
    : null,
].filter((card): card is { label: string; definition: string; value: string } => Boolean(card?.value));
const fragmentPreview = buildFragmentPreview(normalizedSourceText);
const fragmentHasOverflow = Boolean(fragmentPreview) && fragmentPreview.trim() !== normalizedSourceText.trim();
const respawnPreviewEntries = respawnEntries.filter((entry) => entry.key !== 'NOTES').slice(0, 5);
const respawnNotes = respawnEntries.find((entry) => entry.key === 'NOTES')?.value || '';
const hasMemoryPanel = supportingCards.length > 0 || Boolean(normalizedRespawn) || Boolean(normalizedPlatePrompt);
const viewTabs = [
  inspectChamberPlacements.length > 0 ? { id: 'graph', label: 'Structure' } : null,
  normalizedSourceText ? { id: 'fragment', label: 'Fragment' } : null,
  hasMemoryPanel ? { id: 'memory', label: 'Memory' } : null,
].filter((tab): tab is { id: string; label: string } => Boolean(tab));
const defaultViewId = viewTabs[0]?.id || '';
---

<section class="field-surface-wrap">
  <a class="field-surface-back-link" href={objectUrl}>← Back to object</a>

  <article class="field-surface-shell page-plate">
    <header class="field-surface-mast">
      <div class="field-surface-ident">
        <div class="field-surface-heading">
          <p class="field-surface-kicker">HUD</p>
          <h1 class="field-surface-title">{title}</h1>
        </div>
        {surfaceContextLine && <p class="field-surface-context-line">{surfaceContextLine}</p>}
      </div>
    </header>

    <section class="field-surface-strike-wrap" id="strike" aria-label="Strike layer">
      <div class="field-surface-section-kicker">Strike Layer</div>
      <p class="field-surface-layer-note">The fastest operational read of this object right now.</p>
      <div class="field-surface-strike-band">
        <article class="field-surface-strike-item">
          <p class="field-surface-micro">Mode</p>
          <strong>{modeLabel || 'Unscored'}</strong>
        </article>
        <article class="field-surface-strike-item">
          <p class="field-surface-micro">State</p>
          <strong>{stateStrikeValue}</strong>
        </article>
        <article class="field-surface-strike-item">
          <p class="field-surface-micro">Signal</p>
          <strong>{signalStrikeValue}</strong>
        </article>
        <article class="field-surface-strike-item">
          <p class="field-surface-micro">Pressure</p>
          <strong>{pressureStrikeValue}</strong>
        </article>
        <article class="field-surface-strike-item">
          <p class="field-surface-micro">Field</p>
          <strong>{fieldStrikeValue}</strong>
        </article>
      </div>
    </section>

    <section class:list={['field-surface-section', 'field-surface-section--hero', hasHudVisual && 'field-surface-section--visual-anchor']}>
      <div class="field-surface-hero-grid">
        <aside class="field-surface-rail">
          <div class="field-surface-section-kicker">Diagnostic Overview</div>
          <p class="field-surface-layer-note">What is stored around the object right now.</p>
          <dl class="field-surface-rail-list field-surface-rail-list--diagnostic">
            {snapshotRows.map((row) => (
              <div class="field-surface-rail-row">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
          {!packetData && <p class="field-surface-empty">{noPacketMessage}</p>}
        </aside>

        <article class="field-surface-anchor">
          <div class="field-surface-anchor-head">
            <div class="field-surface-section-kicker">{hasHudVisual ? 'Visual Anchor' : 'Hinge'}</div>
            <p class="field-surface-layer-note">
              {hasHudVisual
                ? 'A central visual is present, so the HUD uses it as the anchor for the object read.'
                : 'No visual anchor is present, so the hinge itself becomes the center of the object read.'}
            </p>
          </div>

          {hasHudVisual ? (
            <figure class="field-surface-visual-frame" data-shape={hudVisual?.shape || ''}>
              {hudVisual?.kind === 'image' && (
                <img
                  src={hudVisual.src}
                  alt={hudVisual.alt || `${title} visual anchor`}
                  width={hudVisual.width ?? undefined}
                  height={hudVisual.height ?? undefined}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {hudVisual?.kind === 'video' && (
                <video controls preload="metadata" src={hudVisual.src}>
                  Your browser does not support the video element.
                </video>
              )}
              <figcaption class="field-surface-visual-meta">
                <span>{hudVisual?.role || hudVisual?.kind || 'visual'}</span>
                <span>{hingeCommand}</span>
              </figcaption>
            </figure>
          ) : null}

          <div class:list={['field-surface-anchor-copy', !hasHudVisual && 'field-surface-anchor-copy--hinge-only']}>
            <h2 class="field-surface-anchor-title">{hingeCommand}</h2>
            <p class="field-surface-anchor-summary">{hingeSummary}</p>
            {anchorSupportLine && <p class="field-surface-anchor-support">{anchorSupportLine}</p>}
          </div>
        </article>

        <aside class="field-surface-rail">
          <div class="field-surface-section-kicker">Why This Matters</div>
          <p class="field-surface-layer-note">What the current state means for this object and what it asks of you.</p>
          <dl class="field-surface-rail-list field-surface-rail-list--meaning">
            {valueRegisterCards.map((card) => (
              <div class="field-surface-rail-row field-surface-rail-row--meaning">
                <dt>
                  <span class="field-surface-micro">{card.label}</span>
                  <span class="field-surface-register-definition">{card.definition}</span>
                </dt>
                <dd>{card.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <section class:list={['field-surface-section', 'field-surface-section--flow']}>
      <div class="field-surface-section-kicker">Flow Vector</div>
      <p class="field-surface-layer-note">How pressure enters the object, what stabilizes it, and what state it produces.</p>
      <div class="field-surface-flow-vector" aria-label="Flow vector">
        {flowVectorItems.map((item, index) => (
          <article class="field-surface-flow-step" data-direction={item.direction}>
            <p class="field-surface-flow-card-label">{item.label}</p>
            <strong class="field-surface-flow-card-value">{item.value}</strong>
            {index < flowVectorItems.length - 1 && <span class="field-surface-flow-arrow" aria-hidden="true">→</span>}
          </article>
        ))}
      </div>
    </section>

    <section class="field-surface-section field-surface-section--views" id="views" data-view-root={viewRootId}>
      <div class="field-surface-view-head">
        <div>
          <div class="field-surface-section-kicker">Depth</div>
          <p class="field-surface-layer-note">Open meaning, fragment, structure, or memory only when this object needs more resolution.</p>
        </div>
        <div class="field-surface-view-toggle" role="tablist" aria-label="HUD views">
          {viewTabs.map((tab) => (
            <button
              type="button"
              class:list={['field-surface-view-button', tab.id === defaultViewId && 'is-active']}
              data-view-button={tab.id}
              aria-pressed={tab.id === defaultViewId ? 'true' : 'false'}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>

      <div class="field-surface-view-panel" data-view-panel="fragment" hidden>
        <p class="field-surface-note-label field-surface-fragment-label">Source Fragment</p>
        <p class="field-surface-layer-note">The object body itself, kept separate from the diagnostic read.</p>
        <pre class="field-surface-fragment">{fragmentPreview || 'No source text is available for this object.'}</pre>
        {fragmentHasOverflow && (
          <a class="field-surface-path-link field-surface-path-link--inline" href={objectUrl}>
            <span class="field-surface-path-hint">Open the primary object for the full fragment</span>
          </a>
        )}
      </div>

      {inspectChamberPlacements.length > 0 && (
        <div class="field-surface-view-panel" data-view-panel="graph" hidden>
          <p class="field-surface-note-label">Structure Map</p>
          <p class="field-surface-layer-note">This map shows which chambers hold the object together and how pressure moves between them.</p>
          <div class="field-surface-diagram-grid" data-inspect-root={inspectRootId}>
            <aside class="field-surface-archetype-card">
              <p class="field-surface-archetype-kicker">Hinge</p>
              <h2 class="field-surface-archetype-title">{inspectLeadLabel}</h2>
              {inspectIntro.primary && <p class="field-surface-archetype-copy">{inspectIntro.primary}</p>}
              {inspectIntro.secondary && <p class="field-surface-archetype-support">{inspectIntro.secondary}</p>}

              <div class="field-surface-archetype-meta">
                <span>{inspectSourceLabel}</span>
                {mythmechSummary && <span>{mythmechSummary.nodeCount} nodes / {mythmechSummary.flowCount} flows</span>}
                {!mythmechSummary && packetData && <span>{inspectChamberPlacements.length} packet chambers</span>}
              </div>

              <div class="field-surface-flow-legend" aria-label="Flow legend">
                {inspectLegend.map((item) => (
                  <div class="field-surface-flow-key">
                    <span class="field-surface-flow-swatch" data-flow={item.tone}></span>
                    <div>
                      <p class="field-surface-flow-name">{item.label}</p>
                    </div>
                  </div>
                ))}
              </div>
            </aside>

            <div class="field-surface-stage-shell">
              <div class="field-surface-stage">
                <svg class="field-surface-stage-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  {inspectResolvedConnectors.map((connector) => (
                    <g data-flow={connector.tone}>
                      <line
                        x1={connector.fromPoint.x}
                        y1={connector.fromPoint.y}
                        x2={connector.toPoint.x}
                        y2={connector.toPoint.y}
                      />
                      <circle cx={connector.fromPoint.x} cy={connector.fromPoint.y} r="0.8"></circle>
                      <circle cx={connector.toPoint.x} cy={connector.toPoint.y} r="0.8"></circle>
                    </g>
                  ))}
                </svg>

                {inspectChamberPlacements.map((node) => (
                  <button
                    type="button"
                    class:list={['field-surface-chamber', node.id === inspectInitialNodeId && 'is-active']}
                    data-inspect-node={node.id}
                    data-load={node.load || 'stored'}
                    data-source={node.source}
                    style={`left:${node.point.x}%;top:${node.point.y}%;`}
                    aria-pressed={node.id === inspectInitialNodeId ? 'true' : 'false'}
                  >
                    <span class="field-surface-chamber-role">{node.role}</span>
                    <strong class="field-surface-chamber-label">{node.shortLabel}</strong>
                    <span class="field-surface-chamber-load">{node.load || 'stored'}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="field-surface-focus-stack">
            {inspectDetailCards.map((node) => (
              <article
                id={`inspect-node-${node.id}`}
                class:list={['field-surface-focus-card', node.id === inspectInitialNodeId && 'is-active']}
                data-inspect-detail={node.id}
                hidden={node.id === inspectInitialNodeId ? undefined : true}
              >
                <div class="field-surface-focus-head">
                  <div>
                    <p class="field-surface-focus-kicker">{node.role}</p>
                    <h3 class="field-surface-focus-title">{node.label}</h3>
                  </div>
                  <div class="field-surface-focus-tags">
                    <span>{node.load || 'stored'}</span>
                    <span>{node.source}</span>
                  </div>
                </div>
                {node.primary && <p class="field-surface-focus-summary">{node.primary}</p>}
                {node.secondary && <p class="field-surface-focus-copy">{node.secondary}</p>}

                {(node.flows.length > 0 || node.provenance.length > 0 || node.spawn.length > 0 || node.reverseTrace.length > 0) && (
                  <div class="field-surface-focus-meta-grid">
                    {node.flows.length > 0 && (
                      <div class="field-surface-focus-cluster">
                        <p class="field-surface-focus-label">Flows</p>
                        <ul class="field-surface-focus-list">
                          {node.flows.map((flow) => (
                            <li data-flow={flow.tone}>
                              <span>{flow.direction}</span>
                              <strong>{flow.label}</strong>
                              <em>{flow.target}</em>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {node.reverseTrace.length > 0 && (
                      <div class="field-surface-focus-cluster">
                        <p class="field-surface-focus-label">Reverse Trace</p>
                        <ul class="field-surface-focus-list">
                          {node.reverseTrace.map((step) => (
                            <li data-flow="grounding">
                              <strong>{step}</strong>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {node.provenance.length > 0 && (
                      <div class="field-surface-focus-cluster">
                        <p class="field-surface-focus-label">Provenance</p>
                        <ul class="field-surface-focus-list">
                          {node.provenance.map((item) => (
                            <li><strong>{item}</strong></li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {node.spawn.length > 0 && (
                      <div class="field-surface-focus-cluster">
                        <p class="field-surface-focus-label">Spawnable Vectors</p>
                        <ul class="field-surface-focus-list">
                          {node.spawn.map((item) => (
                            <li><strong>{item}</strong></li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      )}

      {hasMemoryPanel && (
        <div class="field-surface-view-panel" data-view-panel="memory" hidden>
          <p class="field-surface-note-label">Stored Context</p>
          <p class="field-surface-layer-note">Adjacent memory around the object: packet state, lineage, respawn, and authored structure.</p>
          {supportingCards.length > 0 ? (
            <dl class="field-surface-memory-list">
              {supportingCards.map((card) => (
                <div class="field-surface-memory-row">
                  <dt>
                    <span class="field-surface-cluster-label">{card.label}</span>
                    <span class="field-surface-register-definition">{card.definition}</span>
                  </dt>
                  <dd>{card.value}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="field-surface-empty">No supporting packet or Mythmech memory is stored for this object yet.</p>
          )}

          {(normalizedRespawn || mythmechSummary || normalizedPlatePrompt) && (
            <div class="field-surface-note-stack">
              {normalizedRespawn && (
                <article class="field-surface-note-card field-surface-note-card--respawn">
                  <p class="field-surface-note-label">Respawn</p>
                  {respawnLead && <p class="field-surface-note-title">{respawnLead}</p>}
                  {respawnPreviewEntries.length > 0 && (
                    <dl class="field-surface-note-grid">
                      {respawnPreviewEntries.map((entry) => (
                        <div class:list={['field-surface-note-stat', entry.key === 'NOTES' && 'field-surface-note-stat--wide']}>
                          <dt>{entry.label}</dt>
                          <dd>{entry.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {respawnNotes && <p class="field-surface-note-copy">{respawnNotes}</p>}
                </article>
              )}

              {mythmechSummary && (
                <article class="field-surface-note-card">
                  <p class="field-surface-note-label">Mythmech</p>
                  {mythmechLead && <p class="field-surface-note-title">{mythmechLead}</p>}
                  {mythmechSupport && <p class="field-surface-note-copy">{mythmechSupport}</p>}
                  {hasMythmechDetailGrid && (
                    <dl class="field-surface-note-grid">
                      {mythmechSummary.stateCount > 0 && (
                        <div class="field-surface-note-stat">
                          <dt>States</dt>
                          <dd>{mythmechSummary.stateLabels.join(' · ')}</dd>
                        </div>
                      )}
                      {mythmechSummary.hingeLabel && (
                        <div class="field-surface-note-stat">
                          <dt>Hinge</dt>
                          <dd>{mythmechSummary.hingeLabel}</dd>
                        </div>
                      )}
                      {mythmechLoadCopy && (
                        <div class="field-surface-note-stat">
                          <dt>Load</dt>
                          <dd>{mythmechLoadCopy}</dd>
                        </div>
                      )}
                      {mythmechFlowCopy && (
                        <div class="field-surface-note-stat">
                          <dt>Flows</dt>
                          <dd>{mythmechFlowCopy}</dd>
                        </div>
                      )}
                      {mythmechLineageCopy && (
                        <div class="field-surface-note-stat">
                          <dt>Lineage</dt>
                          <dd>{mythmechLineageCopy}</dd>
                        </div>
                      )}
                      {mythmechSummary.spawnCandidateCount > 0 && (
                        <div class="field-surface-note-stat">
                          <dt>Spawnable Vectors</dt>
                          <dd>
                            {mythmechSummary.candidateLabels.length > 0
                              ? mythmechSummary.candidateLabels.join(' · ')
                              : `${mythmechSummary.spawnCandidateCount} vectors`}
                          </dd>
                        </div>
                      )}
                      {(mythmechSignalCopy || mythmechSummary.marginaliaCount > 0) && (
                        <div class:list={['field-surface-note-stat', 'field-surface-note-stat--wide']}>
                          <dt>Marginalia Signals</dt>
                          <dd>
                            {mythmechSignalCopy || `${mythmechSummary.marginaliaCount} entries`}
                          </dd>
                        </div>
                      )}
                    </dl>
                  )}
                </article>
              )}

              {normalizedPlatePrompt && (
                <article class="field-surface-note-card">
                  <p class="field-surface-note-label">Surface Prompt</p>
                  <p class="field-surface-note-copy">{normalizedPlatePrompt}</p>
                </article>
              )}
            </div>
          )}
        </div>
      )}
    </section>
  </article>
</section>

{viewTabs.length > 0 && (
  <script is:inline define:vars={{ viewRootId }}>
    (() => {
      const root = document.querySelector(`[data-view-root="${viewRootId}"]`);
      if (!(root instanceof HTMLElement)) return;

      const buttons = Array.from(root.querySelectorAll('[data-view-button]'));
      const panels = Array.from(root.querySelectorAll('[data-view-panel]'));
      if (buttons.length === 0 || panels.length === 0) return;

      const available = buttons
        .map((button) => (button instanceof HTMLElement ? button.dataset.viewButton || '' : ''))
        .filter(Boolean);

      const setView = (id, updateHash = true) => {
        buttons.forEach((button) => {
          if (!(button instanceof HTMLElement)) return;
          const active = button.dataset.viewButton === id;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          const active = panel.dataset.viewPanel === id;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });

        if (id && updateHash) {
          window.history.replaceState(null, '', `#view-${id}`);
        }
      };

      const hash = window.location.hash.replace(/^#/, '');
      const initialId = hash === 'view-hud' && available.includes('graph')
        ? 'graph'
        : hash.startsWith('inspect-node-') && available.includes('graph')
        ? 'graph'
        : hash.startsWith('view-') && available.includes(hash.slice(5))
          ? hash.slice(5)
          : available[0];

      buttons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        button.addEventListener('click', () => {
          const id = button.dataset.viewButton || '';
          if (id) setView(id);
        });
      });

      if (initialId) setView(initialId, false);
    })();
  </script>
)}

{inspectChamberPlacements.length > 0 && (
  <script is:inline define:vars={{ inspectRootId, inspectInitialNodeId }}>
    (() => {
      const root = document.querySelector(`[data-inspect-root="${inspectRootId}"]`);
      if (!(root instanceof HTMLElement)) return;

      const buttons = Array.from(root.querySelectorAll('[data-inspect-node]'));
      const details = Array.from(root.querySelectorAll('[data-inspect-detail]'));
      if (buttons.length === 0 || details.length === 0) return;

      const setActive = (id, updateHash = true) => {
        buttons.forEach((button) => {
          if (!(button instanceof HTMLElement)) return;
          const active = button.dataset.inspectNode === id;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        details.forEach((detail) => {
          if (!(detail instanceof HTMLElement)) return;
          const active = detail.dataset.inspectDetail === id;
          detail.hidden = !active;
          detail.classList.toggle('is-active', active);
        });

        if (id && updateHash) {
          window.history.replaceState(null, '', `#inspect-node-${id}`);
        }
      };

      const initialHash = window.location.hash.replace(/^#inspect-node-/, '');
      const initialId =
        buttons.some((button) => button instanceof HTMLElement && button.dataset.inspectNode === initialHash)
          ? initialHash
          : inspectInitialNodeId;

      buttons.forEach((button) => {
        if (!(button instanceof HTMLElement)) return;
        button.addEventListener('click', () => {
          const id = button.dataset.inspectNode || '';
          if (id) setActive(id);
        });
      });

      if (initialId) setActive(initialId, window.location.hash.startsWith('#inspect-node-'));
    })();
  </script>
)}

<style>
  .field-surface-wrap {
    width: min(100%, 1180px);
    margin: clamp(2.4rem, 4.4vw, 4.2rem) auto 4.4rem;
    display: grid;
    gap: 1.2rem;
    color: var(--field-amber-em);
  }

  .field-surface-shell {
    --surface-radius: 6px;
    --surface-chip-radius: 6px;
    --surface-line: var(--field-line-soft);
    --surface-line-strong: var(--field-line-strong);
    --surface-panel: var(--field-panel);
    --surface-panel-elevated: var(--field-panel-elevated);
    --surface-panel-wash: var(--field-panel-wash);
    --surface-panel-line: var(--field-panel-line);
    --surface-accent-soft: var(--field-accent-soft);
    --surface-accent-line: var(--field-accent-line);
    --surface-accent-fill: var(--field-accent-fill);
    --surface-accent-glow: var(--field-accent-glow);
    position: relative;
    overflow: hidden;
    padding: clamp(1.45rem, 2.9vw, 2.35rem);
    border: 1px solid var(--surface-line);
    border-radius: var(--surface-radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent 18%),
