  .field-surface-visual-frame[data-shape='portrait'] img,
  .field-surface-visual-frame[data-shape='tall'] img {
    max-height: 34rem;
  }

  .field-surface-visual-frame[data-shape='wide'] img,
  .field-surface-visual-frame[data-shape='landscape'] img,
  .field-surface-visual-frame[data-shape='square'] img,
