---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Carrier Pigeon</title>
    <meta name="description" content="Phone-first publishing into the ndcodex archive." />
    <meta name="theme-color" content="#d59a4a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Carrier Pigeon" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/pigeon.webmanifest" />
    <style>
      :root {
        color-scheme: dark;
        --bg: #120d0a;
        --panel: rgba(19, 13, 10, 0.96);
        --line: rgba(255, 243, 223, 0.12);
        --line-strong: rgba(255, 230, 190, 0.24);
        --text: #f6efe4;
        --muted: #d3be9d;
        --muted-strong: #edd5b2;
        --accent: #d59a4a;
        --accent-strong: #efb258;
        --success: #9fd1a7;
        --danger: #e38b76;
        --radius-soft: 0;
        --radius-hard: 0;
        --shadow: 0 26px 60px rgba(0, 0, 0, 0.32);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        min-height: 100vh;
        padding: max(22px, env(safe-area-inset-top)) 18px max(26px, env(safe-area-inset-bottom));
        background:
          radial-gradient(circle at top, rgba(213, 154, 74, 0.24), transparent 34%),
          radial-gradient(circle at 20% 20%, rgba(207, 113, 64, 0.18), transparent 28%),
          linear-gradient(180deg, #22160e 0%, var(--bg) 55%);
        color: var(--text);
        font-family: "Avenir Next", Avenir, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      main {
        width: min(100%, 860px);
        margin: 0 auto;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 28px 20px 20px;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-soft);
        background:
          radial-gradient(circle at top right, rgba(255, 214, 153, 0.16), transparent 30%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)),
          rgba(26, 19, 14, 0.9);
        box-shadow: var(--shadow);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding: 7px 12px;
        border: 1px solid var(--line);
        border-radius: var(--radius-soft);
        background: rgba(255, 255, 255, 0.04);
        color: var(--muted-strong);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: "";
        width: 9px;
        height: 9px;
        background: var(--success);
        box-shadow: 0 0 0 6px rgba(159, 209, 167, 0.14);
      }

      h1 {
        margin: 0;
        font-size: clamp(2.7rem, 7vw, 4.4rem);
        line-height: 0.95;
        letter-spacing: -0.05em;
      }

      .deck {
        margin: 12px 0 0;
        max-width: 34rem;
        color: var(--muted);
        font-size: 1.06rem;
        line-height: 1.55;
      }

      .grid {
        margin-top: 18px;
        display: grid;
        gap: 14px;
      }

      .panel {
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: var(--radius-soft);
        background: var(--panel);
        box-shadow: var(--shadow);
      }

      .panel-title {
        margin: 0 0 8px;
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--muted-strong);
      }

      .panel-copy,
      .meta-copy {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
      }

      .form-shell,
      .status-shell {
        display: grid;
        gap: 14px;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .chip {
        appearance: none;
        border: 1px solid var(--line);
        border-radius: var(--radius-soft);
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--text);
        font: inherit;
        font-size: 14px;
        font-weight: 600;
      }

      .field {
        display: grid;
        gap: 8px;
      }

      .field-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
      }

      .field label {
        color: var(--muted-strong);
        font-size: 0.94rem;
        font-weight: 700;
      }

      .helper {
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.45;
      }

      input[type="password"],
      textarea {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: var(--radius-soft);
        background: rgba(0, 0, 0, 0.26);
        color: var(--text);
        font: inherit;
      }

      input[type="password"]::placeholder,
      textarea::placeholder {
        color: rgba(244, 239, 228, 0.4);
      }

      textarea {
        min-height: 360px;
        line-height: 1.55;
        resize: vertical;
      }

      .file-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
      }

      .file-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 16px;
        border: 1px solid var(--line);
        border-radius: var(--radius-soft);
        background: rgba(255, 255, 255, 0.06);
        color: var(--text);
        font-weight: 700;
      }

      .file-name {
        color: var(--muted-strong);
        font-size: 0.95rem;
      }

      input[type="file"] {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
      }

      .toolbar {
        display: grid;
        gap: 10px;
      }

      .primary {
        appearance: none;
        border: 0;
        border-radius: var(--radius-hard);
        padding: 16px 18px;
        background: linear-gradient(180deg, var(--accent-strong), var(--accent));
        color: #1c140d;
        font: inherit;
        font-size: 1.06rem;
        font-weight: 800;
        letter-spacing: 0.01em;
      }

      .secondary-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .secondary {
        flex: 1;
        appearance: none;
        border: 1px solid var(--line);
        border-radius: var(--radius-hard);
        padding: 12px 14px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--text);
        font: inherit;
        font-weight: 600;
      }

      .status-bar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
      }

      .status-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--muted-strong);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .status-label::before {
        content: "";
        width: 10px;
        height: 10px;
        background: var(--muted);
      }

      .status-label.is-success::before {
        background: var(--success);
      }

      .status-label.is-error::before {
        background: var(--danger);
      }

      .status-copy {
        color: var(--muted);
        font-size: 14px;
        text-align: right;
      }

      .result-meta {
        display: none;
        gap: 10px;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      }

      .result-meta.is-visible {
        display: grid;
      }

      .result-card {
        padding: 12px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.03);
      }

      .result-card p {
        margin: 0 0 4px;
        color: var(--muted);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .result-card strong,
      .result-card a {
        color: var(--text);
        font-size: 0.98rem;
        word-break: break-word;
      }

      pre {
        margin: 0;
        padding: 16px;
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: var(--radius-soft);
        background: rgba(0, 0, 0, 0.3);
        color: var(--text);
        white-space: pre-wrap;
        word-break: break-word;
      }

      .route-list {
        display: grid;
        gap: 8px;
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.45;
      }

      .route-list strong {
        color: var(--muted-strong);
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      }

      @media (min-width: 840px) {
        .grid {
          grid-template-columns: 1.18fr 0.82fr;
        }

        .hero {
          padding: 30px 24px 24px;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="eyebrow">Remote archive ingest</div>
        <h1>Carrier Pigeon</h1>
        <p class="deck">
          Publish a markdown note from your phone, authenticate with your Carrier Pigeon key, and
          commit it straight into the ndcodex repository from anywhere.
        </p>
      </section>

      <section class="grid">
        <section class="panel form-shell">
          <div>
            <h2 class="panel-title">Publish Note</h2>
            <p class="panel-copy">
              Use <code>object_type</code> in frontmatter to route notes into
              <code>signal</code>, <code>codex</code>, and the other archive collections. Attach
              matching image files if your note references local Obsidian images.
            </p>
          </div>

          <div class="actions">
            <button class="chip" type="button" data-template="signal">Signal Template</button>
            <button class="chip" type="button" data-template="codex">Codex Template</button>
          </div>

          <div class="field">
            <div class="field-row">
              <label for="pigeon-key">Publishing Key</label>
              <button class="chip" id="forget-key" type="button">Forget Saved Key</button>
            </div>
            <input
              id="pigeon-key"
              type="password"
              inputmode="text"
              autocomplete="off"
              placeholder="Paste the Carrier Pigeon key once on this device"
            />
            <p class="helper">
              Stored only in this browser on this phone so you do not have to re-enter it every
              time.
            </p>
          </div>

          <div class="file-row">
            <label class="file-label" for="file">Choose Markdown File</label>
            <span class="file-name" id="file-name">No file selected yet</span>
          </div>
          <input id="file" type="file" accept=".md,.markdown,text/markdown,text/plain" />

          <div class="file-row">
            <label class="file-label" for="images">Attach Images</label>
            <span class="file-name" id="image-name">No images selected yet</span>
          </div>
          <input id="images" type="file" accept="image/*" multiple />
          <p class="helper">
            If the note body contains <code>![[image.jpg]]</code> or markdown image links, Carrier
            Pigeon will rewrite matching file names to the uploaded public image paths.
          </p>

          <textarea id="note" spellcheck="false" placeholder="Paste a markdown note or load one from Files."></textarea>

          <div class="toolbar">
            <button class="primary" id="publish" type="button">Publish To Carrier Pigeon</button>
            <div class="secondary-row">
              <button class="secondary" id="clear-note" type="button">Clear Note</button>
              <button class="secondary" id="copy-url" type="button">Copy App URL</button>
            </div>
          </div>
        </section>

        <section class="panel status-shell">
          <div>
            <h2 class="panel-title">Phone Workflow</h2>
            <p class="panel-copy">
              Save this page to your home screen from Safari for the cleanest one-tap launch. You
              can also make a Shortcut that just opens this URL.
            </p>
          </div>

          <div class="route-list">
            <div><strong>Install:</strong> Safari share menu -> <code>Add to Home Screen</code></div>
            <div><strong>Minimal Shortcut:</strong> one action, <code>Open URLs</code> -> <code>/pigeon</code></div>
            <div><strong>Remote publish:</strong> posts to <code>/api/pigeon</code> with your saved key</div>
          </div>

          <div class="status-bar">
            <span class="status-label" id="status-label">Idle</span>
            <span class="status-copy" id="status-copy">Waiting for note input.</span>
          </div>

          <section class="result-meta" id="result-meta">
            <article class="result-card">
              <p>Object Type</p>
              <strong id="result-type">-</strong>
            </article>
            <article class="result-card">
              <p>Slug</p>
              <strong id="result-slug">-</strong>
            </article>
            <article class="result-card">
              <p>Archive Path</p>
              <a id="result-url" href="/" target="_blank" rel="noreferrer">-</a>
            </article>
            <article class="result-card">
              <p>Commit</p>
              <a id="result-commit" href="/" target="_blank" rel="noreferrer">-</a>
            </article>
          </section>

          <pre id="result">Waiting for note input.</pre>
        </section>
      </section>
    </main>

    <script>
      const endpoint = '/api/pigeon';
      const storageKey = 'carrier-pigeon.shared-key';
      const draftKey = 'carrier-pigeon.note-draft';
      const sampleTemplates = {
        signal: `---\ntitle: Signal Dispatch\ntype: signal\ndate: 2026-03-14\ntags:\n  - signal\n---\nSignals are epiphanies prepared for transmission.\n\nSmall enough to move quickly.\nClear enough to travel alone.`,
        codex: `---\ntitle: Carrier Pigeon Notes\ntype: codex\ndate: 2026-03-14\ntags:\n  - codex\n  - dispatch\n---\nCarrier Pigeon is now routing notes by object type.`,
      };

      const keyField = document.getElementById('pigeon-key');
      const forgetKeyButton = document.getElementById('forget-key');
      const fileInput = document.getElementById('file');
      const fileName = document.getElementById('file-name');
      const imageInput = document.getElementById('images');
      const imageName = document.getElementById('image-name');
      const noteField = document.getElementById('note');
      const result = document.getElementById('result');
      const publishButton = document.getElementById('publish');
      const clearNoteButton = document.getElementById('clear-note');
      const copyUrlButton = document.getElementById('copy-url');
      const statusLabel = document.getElementById('status-label');
      const statusCopy = document.getElementById('status-copy');
      const resultMeta = document.getElementById('result-meta');
      const resultType = document.getElementById('result-type');
      const resultSlug = document.getElementById('result-slug');
      const resultUrl = document.getElementById('result-url');
      const resultCommit = document.getElementById('result-commit');

      keyField.value = localStorage.getItem(storageKey) || '';
      noteField.value = localStorage.getItem(draftKey) || '';

      function setStatus(kind, label, copy) {
        statusLabel.textContent = label;
        statusLabel.className = 'status-label' + (kind === 'success' ? ' is-success' : kind === 'error' ? ' is-error' : '');
        statusCopy.textContent = copy;
      }

      function resetResultMeta() {
        resultMeta.classList.remove('is-visible');
        resultType.textContent = '-';
        resultSlug.textContent = '-';
        resultUrl.textContent = '-';
        resultUrl.href = '/';
        resultCommit.textContent = '-';
        resultCommit.href = '/';
      }

      function updateResultMeta(data) {
        if (!data || !data.slug || !data.url) {
          resetResultMeta();
          return;
        }

        resultMeta.classList.add('is-visible');
        resultType.textContent = data.objectType || data.object_type || 'fragment';
        resultSlug.textContent = data.slug;
        resultUrl.textContent = data.url;
        resultUrl.href = data.url;
        if (data.commitUrl) {
          resultCommit.textContent = 'Open commit';
          resultCommit.href = data.commitUrl;
        } else {
          resultCommit.textContent = data.mode || 'local';
          resultCommit.href = '/';
        }
      }

      function describeImageSelection(files) {
        if (!files.length) {
          return 'No images selected yet';
        }

        if (files.length === 1) {
          return files[0].name;
        }

        return files.length + ' images selected';
      }

      async function readImageElement(file) {
        if (typeof createImageBitmap === 'function') {
          try {
            return await createImageBitmap(file);
          } catch {
            // Fall through to HTML image loading below.
          }
        }

        return await new Promise((resolve, reject) => {
          const objectUrl = URL.createObjectURL(file);
          const image = new Image();
          image.onload = () => {
            URL.revokeObjectURL(objectUrl);
            resolve(image);
          };
          image.onerror = (error) => {
            URL.revokeObjectURL(objectUrl);
            reject(error);
          };
          image.src = objectUrl;
        });
      }

      async function compressImageForUpload(file) {
        if (!file.type.startsWith('image/')) {
          return file;
        }

        if (file.size <= 1_800_000) {
          return file;
        }

        try {
          const image = await readImageElement(file);
          const width = image.width || image.naturalWidth || 0;
          const height = image.height || image.naturalHeight || 0;
          if (!width || !height) {
            return file;
          }

          const maxDimension = 2000;
          const scale = Math.min(1, maxDimension / Math.max(width, height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(width * scale));
          canvas.height = Math.max(1, Math.round(height * scale));
          const context = canvas.getContext('2d');
          if (!context) {
            return file;
          }

          context.drawImage(image, 0, 0, canvas.width, canvas.height);
          const outputType = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
          const blob = await new Promise((resolve) => {
            canvas.toBlob(resolve, outputType, outputType === 'image/png' ? undefined : 0.86);
          });

          if (!(blob instanceof Blob) || blob.size === 0 || blob.size >= file.size) {
            return file;
          }

          return new File([blob], file.name, {
            type: outputType,
            lastModified: Date.now(),
          });
        } catch {
          return file;
        }
      }

      keyField.addEventListener('input', () => {
        const key = keyField.value.trim();
        if (key) {
          localStorage.setItem(storageKey, key);
        } else {
          localStorage.removeItem(storageKey);
        }
      });

      forgetKeyButton.addEventListener('click', () => {
        keyField.value = '';
        localStorage.removeItem(storageKey);
        setStatus('idle', 'Key cleared', 'The saved publishing key has been removed from this device.');
      });

      noteField.addEventListener('input', () => {
        localStorage.setItem(draftKey, noteField.value);
      });

      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        noteField.value = await file.text();
        localStorage.setItem(draftKey, noteField.value);
        fileName.textContent = file.name;
        setStatus('idle', 'Loaded', 'Review the note and publish when ready.');
        result.textContent = 'Loaded file: ' + file.name;
        resetResultMeta();
      });

      imageInput.addEventListener('change', () => {
        const files = Array.from(imageInput.files || []);
        imageName.textContent = describeImageSelection(files);
        if (files.length > 0) {
          setStatus('idle', 'Images ready', 'Carrier Pigeon will upload and attach the selected images.');
          result.textContent = 'Queued ' + describeImageSelection(files) + ' for upload.';
          resetResultMeta();
        }
      });

      document.querySelectorAll('[data-template]').forEach((button) => {
        button.addEventListener('click', () => {
          const template = sampleTemplates[button.dataset.template];
          noteField.value = template;
          localStorage.setItem(draftKey, template);
          fileName.textContent = 'Template loaded';
          setStatus('idle', 'Template ready', 'Edit the template, then publish.');
          result.textContent = 'Template loaded into the editor.';
          resetResultMeta();
        });
      });

      clearNoteButton.addEventListener('click', () => {
        noteField.value = '';
        fileInput.value = '';
        imageInput.value = '';
        fileName.textContent = 'No file selected yet';
        imageName.textContent = 'No images selected yet';
        localStorage.removeItem(draftKey);
        setStatus('idle', 'Cleared', 'Paste a note or choose a file.');
        result.textContent = 'Editor cleared.';
        resetResultMeta();
      });

      copyUrlButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          setStatus('success', 'Copied', 'Carrier Pigeon app URL copied to the clipboard.');
        } catch {
          setStatus('error', 'Copy failed', 'Could not copy the URL from this browser.');
        }
      });

      publishButton.addEventListener('click', async () => {
        const note = noteField.value.trim();
        const key = keyField.value.trim();

        if (!key) {
          setStatus('error', 'Key required', 'Enter the Carrier Pigeon publishing key first.');
          result.textContent = 'Enter the Carrier Pigeon publishing key first.';
          resetResultMeta();
          return;
        }

        if (!note) {
          setStatus('error', 'No note', 'Paste a markdown note or choose a file first.');
          result.textContent = 'Paste a markdown note or choose a file first.';
          resetResultMeta();
          return;
        }

        publishButton.disabled = true;
        publishButton.textContent = 'Publishing...';
        setStatus('idle', 'Publishing', 'Preparing note and media for the archive.');
        result.textContent = 'Publishing...';

        try {
          const formData = new FormData();
          formData.append('note', note);

          const selectedImages = Array.from(imageInput.files || []);
          if (selectedImages.length > 0) {
            setStatus('idle', 'Preparing media', 'Compressing images for upload from your phone.');
          }

          const preparedImages = await Promise.all(selectedImages.map((file) => compressImageForUpload(file)));
          preparedImages.forEach((file) => {
            formData.append('images', file, file.name);
          });

          const response = await fetch(endpoint, {
            method: 'POST',
            headers: {
              Authorization: 'Bearer ' + key,
            },
            body: formData,
          });

          const text = await response.text();
          result.textContent = text;

          let parsed = null;
          try {
            parsed = JSON.parse(text);
          } catch {
            parsed = null;
          }

          if (response.ok) {
            setStatus('success', 'Published', parsed?.note || 'Carrier Pigeon accepted the note.');
            updateResultMeta(parsed);
          } else {
            setStatus('error', 'Publish failed', parsed?.error || 'The archive rejected the note.');
            updateResultMeta(parsed);
          }
        } catch (error) {
          setStatus('error', 'Network error', 'Could not reach Carrier Pigeon.');
          result.textContent = String(error);
          resetResultMeta();
        } finally {
          publishButton.disabled = false;
          publishButton.textContent = 'Publish To Carrier Pigeon';
        }
      });

      if (noteField.value.trim()) {
        setStatus('idle', 'Draft restored', 'Recovered the last draft stored on this device.');
      }
    </script>
  </body>
</html>
