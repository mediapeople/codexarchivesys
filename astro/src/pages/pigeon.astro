---
import {
  PIGEON_APP_SCRIPT,
  PIGEON_APP_STYLES,
  renderPigeonAppMarkup,
  serializePigeonAppConfig,
} from '../lib/pigeon-app.js';

export const prerender = true;

const uiConfig = {
  eyebrow: 'Remote archive ingest',
  deck:
    'Publish from your phone with text, images, or image-only artifacts, authenticate with your Carrier Pigeon key, and commit straight into the ndcodex repository from anywhere. Published scrolls automatically get the HUD treatment.',
  attachNote:
    'Image-only publish is allowed. If the note body contains ![[image.jpg]] or markdown image links, Carrier Pigeon will rewrite matching file names to the uploaded public image paths.',
  keyNote:
    'Stored only in this browser on this phone so you do not have to re-enter it every time.',
  workflowTitle: 'Phone workflow',
  workflowSteps: [
    'Add to home screen - Safari -> Add to Home Screen',
    'Paste raw text and run Smart Draft for frontmatter plus nearby related suggestions, or select type and load a template shell',
    'With images attached, a short note becomes a caption by default; title: and caption: lines also work',
    'Confirm telemetry shows correct type, slug, and path',
    'Send Pigeon - published scrolls automatically get object + HUD routes',
  ],
  copyButtonLabel: 'Copy App URL',
  archiveHref: 'https://ndcodex.com/',
  archiveLabel: '<- ND Codex Archive',
};

const appConfig = {
  endpoint: '/api/pigeon',
  authRequired: true,
  keyStorageKey: 'carrier-pigeon.shared-key',
  draftStorageKey: 'carrier-pigeon.note-draft',
  contentRoot: 'astro/src/content',
  copySuccessMessage: 'Carrier Pigeon app URL copied to the clipboard.',
  copyFailureMessage: 'Could not copy the Carrier Pigeon URL from this browser.',
  imageReadyMessage: 'Carrier Pigeon will upload and attach the selected images. Short image notes now publish as captions by default.',
  successMessage: 'Carrier Pigeon accepted the note.',
  networkErrorMessage: 'Could not reach Carrier Pigeon.',
  noNoteMessage: 'Add a markdown note or attach at least one image first.',
  noKeyMessage: 'Enter the Carrier Pigeon publishing key first.',
  preparingMessage: 'Preparing note and media for the archive.',
  preparingImagesMessage: 'Compressing images for upload from your phone.',
  restoredDraftMessage: 'Recovered the last draft stored on this device.',
  keyClearedMessage: 'The saved publishing key has been removed from this device.',
  templateLoadedMessage: 'Fill in metadata if you want, or attach images and publish.',
  fileLoadedMessage: 'Review the note and publish when ready.',
  editorClearedMessage: 'Editor cleared.',
  smartDraftReadyMessage: 'Smart Draft inferred frontmatter and checked the archive for nearby related objects. Review it, then send again.',
  smartDraftButtonMessage: 'Review the inferred frontmatter and any related suggestions below, then send when ready.',
  publishedSurfaceScrollMessage:
    'Published scrolls automatically generate a HUD. Open the object to read, or HUD to inspect.',
  publishedSurfaceDefaultMessage: 'Published to the archive. Open the object to confirm it landed.',
};

const markup = renderPigeonAppMarkup(uiConfig);
const serializedConfig = serializePigeonAppConfig(appConfig);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Carrier Pigeon</title>
    <meta name="description" content="Phone-first publishing into the ndcodex archive." />
    <meta name="theme-color" content="#111009" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Carrier Pigeon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/pigeon.webmanifest" />
    <style is:inline set:html={PIGEON_APP_STYLES}></style>
  </head>
  <body>
    <Fragment set:html={markup} />
    <script id="pigeon-app-config" type="application/json" set:html={serializedConfig}></script>
    <script is:inline set:html={PIGEON_APP_SCRIPT}></script>
  </body>
</html>
