---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicObjectEntries } from '../../lib/follow';
import { formatDisplayTitle } from '../../lib/headline';
import {
  getPublicTaxonomyRecords,
  getTaxonomyDefinition,
  getTaxonomyTermPath,
} from '../../lib/taxonomy';
import { toSiteUrl } from '../../lib/site';

const entries = await getPublicObjectEntries();
const records = await getPublicTaxonomyRecords('constellation');
const featuredConstellation = records[0] ?? null;
const description = `Constellations in the Codex Archive. ${records.length} constellations across ${entries.length} public objects.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Constellations | Codex Archive',
  description,
  url: toSiteUrl('/constellations'),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Codex Archive',
    url: toSiteUrl('/'),
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: records.length,
    itemListElement: records.map((record, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: record.term,
      url: toSiteUrl(getTaxonomyTermPath('constellation', record.term)),
    })),
  },
};
---

<BaseLayout
  title="Constellations | Codex Archive"
  description={description}
  canonicalPath="/constellations"
  structuredData={structuredData}
>
  <section class="taxonomy-hero page-hero">
    <p class="page-hero-eyebrow">Taxonomy</p>
    <h1 class="page-hero-title">Constellations</h1>
    <p class="page-hero-sub">{getTaxonomyDefinition('constellation')}</p>
    <div class="taxonomy-stats">
      <article class="page-plate">
        <strong>{records.length}</strong>
        <span>Constellations active</span>
      </article>
      <article class="page-plate">
        <strong>{entries.length}</strong>
        <span>Public objects</span>
      </article>
      {featuredConstellation && (
        <article class="page-plate">
          <strong>{featuredConstellation.term}</strong>
          <span>Largest cluster ({featuredConstellation.count})</span>
        </article>
      )}
    </div>
  </section>

  <section class="taxonomy-directory page-plate">
    <div class="taxonomy-directory-head">
      <div>
        <p class="taxonomy-kicker">Browse</p>
        <h2>Constellation landing pages</h2>
      </div>
      <a class="taxonomy-sibling-link" href="/themes">View themes</a>
    </div>

    <div class="taxonomy-grid">
      {records.map((record) => (
        <a class="taxonomy-card page-plate" href={getTaxonomyTermPath('constellation', record.term)}>
          <p class="taxonomy-card-kicker">Constellation</p>
          <h3>{record.term}</h3>
          <p class="taxonomy-card-count">{record.count} objects</p>
          {record.entries[0] && (
            <p class="taxonomy-card-note">
              Latest: {formatDisplayTitle(record.entries[0].data.title)}
            </p>
          )}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .taxonomy-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.9rem;
  }

  .taxonomy-stats article {
    display: grid;
    gap: 0.24rem;
  }

  .taxonomy-stats strong {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.2vw, 2.3rem);
    line-height: 1.05;
  }

  .taxonomy-stats span {
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 0.74rem;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .taxonomy-directory {
    margin-top: 2.4rem;
    padding: 1.4rem;
  }

  .taxonomy-directory-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .taxonomy-directory-head h2,
  .taxonomy-card h3 {
    margin: 0;
  }

  .taxonomy-kicker,
  .taxonomy-card-kicker {
    margin: 0 0 0.38rem;
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .taxonomy-sibling-link {
    color: var(--parchment);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 240, 232, 0.18);
    padding-bottom: 0.16rem;
  }

  .taxonomy-sibling-link:hover {
    color: var(--star);
    border-bottom-color: rgba(244, 240, 232, 0.42);
  }

  .taxonomy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .taxonomy-card {
    display: grid;
    gap: 0.48rem;
    text-decoration: none;
    color: inherit;
    padding: 1rem 1.02rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0)),
      color-mix(in srgb, var(--card) 88%, rgba(120, 160, 168, 0.06));
    transition: transform 0.14s ease, border-color 0.14s ease, background 0.14s ease;
  }

  .taxonomy-card:hover {
    transform: translateY(-2px);
    border-color: rgba(244, 240, 232, 0.18);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
      color-mix(in srgb, var(--card) 90%, rgba(120, 160, 168, 0.1));
  }

  .taxonomy-card-count {
    margin: 0;
    color: var(--ash);
    font-family: var(--font-ui);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .taxonomy-card-note {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.65;
    font-size: 0.98rem;
  }

  @media (max-width: 700px) {
    .taxonomy-directory {
      padding: 1rem;
    }

    .taxonomy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
