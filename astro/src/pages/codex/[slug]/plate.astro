---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FieldSurface from '../../../components/hud/FieldSurface.astro';
import { getAllEntries } from '../../../lib/archive';
import { formatDisplayTitle } from '../../../lib/headline';
import { loadObjectSidecars } from '../../../lib/loadObjectSidecars';
import { getObjectSlug } from '../../../lib/objectInterop';

export async function getStaticPaths() {
  const entries = (await getAllEntries()).filter(
    (entry) =>
      entry.data.status === 'published' &&
      (entry.data.visibility === 'public' || entry.data.visibility === 'unlisted')
  );

  return entries.map((entry) => ({
    params: { slug: getObjectSlug(entry) },
  }));
}

const entries = (await getAllEntries()).filter(
  (entry) =>
    entry.data.status === 'published' &&
    (entry.data.visibility === 'public' || entry.data.visibility === 'unlisted')
);
const entry = entries.find((candidate) => getObjectSlug(candidate) === Astro.params.slug);

if (!entry) {
  throw new Error(`Object not found for slug: ${Astro.params.slug}`);
}

const slug = getObjectSlug(entry);
const objectUrl = entry.collection === 'codex' ? `/codex/${encodeURIComponent(slug)}` : `/objects/${encodeURIComponent(slug)}`;
const { packet, respawn, mythmech, platePrompt } = await loadObjectSidecars(entry.filePath);
const displayTitle = formatDisplayTitle(entry.data.title);
const canonicalPath = `/codex/${encodeURIComponent(slug)}/plate`;
---

<BaseLayout
  title={`${displayTitle} · Report`}
  description={`Inspect report surface for ${displayTitle}.`}
  canonicalPath={canonicalPath}
>
  <FieldSurface
    title={displayTitle}
    objectUrl={objectUrl}
    packet={packet}
    mythmech={mythmech}
    platePrompt={platePrompt}
    sourceText={entry.body}
    respawn={respawn}
    initialView="plate"
  />
</BaseLayout>
