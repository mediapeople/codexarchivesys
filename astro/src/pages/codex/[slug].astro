---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InspectModePanel from '../../components/InspectModePanel.astro';
import MarginaliaPanel from '../../components/MarginaliaPanel.astro';
import ObjectIdentityBadge from '../../components/ObjectIdentityBadge.astro';
import { getAllEntries } from '../../lib/archive';
import { listAxes, readAxes } from '../../lib/axes';
import { formatDisplayTitle } from '../../lib/headline';
import { loadObjectSidecars } from '../../lib/loadObjectSidecars';
import { getMarginaliaEntriesForTarget, getMythmechMarginaliaEntries } from '../../lib/marginalia';
import { getBodyImagePreviewItems } from '../../lib/media';
import {
  getObjectJsonLd,
  getObjectJsonPath,
  getObjectMarkdownPath,
  getObjectPath,
  getObjectSummary,
} from '../../lib/objectInterop';
import { formatArchiveLongDate } from '../../lib/timeline';
import { bodyStartsWithDuplicateTitleHeading, resolveExcerpt } from '../../lib/excerpt';

type ObjectFormType = 'bubble' | 'coordinate' | 'creature';

function normalizeObjectForm(value: unknown): ObjectFormType | '' {
  if (typeof value !== 'string') {
    return '';
  }

  const normalized = value.trim().toLowerCase();
  return normalized === 'bubble' || normalized === 'coordinate' || normalized === 'creature'
    ? normalized
    : '';
}

function objectFormDescription(value: ObjectFormType): string {
  if (value === 'bubble') {
    return 'Language fragment that survives alone.';
  }
  if (value === 'coordinate') {
    return 'Form that keeps its structure under isolation.';
  }
  return 'Living pattern responding to pressure.';
}

function normalizeCaptureTextValue(value: unknown): string {
  if (typeof value === 'string') {
    return value.trim();
  }

  if (Array.isArray(value)) {
    return value
      .map((item) => (typeof item === 'string' ? item.trim() : ''))
      .filter(Boolean)
      .join(' · ');
  }

  if (typeof value === 'boolean') {
    return value ? 'yes' : 'no';
  }

  return '';
}

function getObjectFormNote(
  form: ObjectFormType | '',
  capture: Record<string, unknown> | null
): { label: string; text: string } | null {
  if (!form || !capture) {
    return null;
  }

  const orientation =
    capture.orientation && typeof capture.orientation === 'object' && !Array.isArray(capture.orientation)
      ? (capture.orientation as Record<string, unknown>)
      : null;
  const orientationResponses =
    orientation?.responses && typeof orientation.responses === 'object' && !Array.isArray(orientation.responses)
      ? (orientation.responses as Record<string, unknown>)
      : null;
  const trace =
    capture.trace && typeof capture.trace === 'object' && !Array.isArray(capture.trace)
      ? (capture.trace as Record<string, unknown>)
      : null;
  const traceExpanded =
    trace?.expanded && typeof trace.expanded === 'object' && !Array.isArray(trace.expanded)
      ? (trace.expanded as Record<string, unknown>)
      : null;

  const pick = (...values: unknown[]): string => {
    for (const value of values) {
      const normalized = normalizeCaptureTextValue(value);
      if (normalized) {
        return normalized;
      }
    }
    return '';
  };

  if (form === 'bubble') {
    const survives = pick(orientationResponses?.survives_alone, traceExpanded?.survives_alone);
    if (survives) {
      return { label: 'Survives', text: survives };
    }
  }

  if (form === 'coordinate') {
    const holds = pick(orientationResponses?.holds_under_isolation, traceExpanded?.holds_under_isolation);
    if (holds) {
      return { label: 'Holds', text: holds };
    }
    const fieldBreak = pick(orientationResponses?.field_break, traceExpanded?.field_break);
    if (fieldBreak) {
      return { label: 'Field Break', text: fieldBreak };
    }
  }

  if (form === 'creature') {
    const pressure = pick(orientationResponses?.pressure, traceExpanded?.pressure);
    if (pressure) {
      return { label: 'Pressure', text: pressure };
    }
  }

  const tracePull = pick(trace?.pull);
  if (tracePull) {
    return { label: 'Trace', text: tracePull };
  }

  return null;
}

export async function getStaticPaths() {
  const entries = (await getCollection('codex')).filter(
    (entry) => entry.data.status === 'published' && entry.data.visibility === 'public'
  );

  return entries.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const entries = (await getCollection('codex')).filter(
  (entry) => entry.data.status === 'published' && entry.data.visibility === 'public'
);
const entry = entries.find((candidate) => candidate.slug === Astro.params.slug);

if (!entry) {
  throw new Error(`Missing public codex entry for slug: ${Astro.params.slug}`);
}

const { Content } = await entry.render();
const entryBody = typeof entry.body === 'string' ? entry.body : '';

const displayTitle = formatDisplayTitle(entry.data.title);
const readableDate = formatArchiveLongDate(entry.data);
const tags = entry.data.tags.length > 0 ? entry.data.tags : entry.data.themes;
const directImages = entry.data.images.map((image) => image.trim()).filter(Boolean);
const mediaImages = entry.data.media
  .filter((item) => item.kind === 'image')
  .map((item) => item.src.trim())
  .filter(Boolean);
const inlineBodyImages = getBodyImagePreviewItems(entryBody).map((item) => item.src.trim()).filter(Boolean);
const images = [...new Set(directImages.length > 0 ? directImages : mediaImages.length > 0 ? mediaImages : inlineBodyImages)];
const inlineImageSrcs = new Set(inlineBodyImages);
const galleryImages = images.filter((image) => !inlineImageSrcs.has(image));
const state = entry.data.state ?? entry.data.status;
const axes = listAxes(readAxes(entry.data as Record<string, unknown>));
const summary = getObjectSummary(entry);
const hideLeadHeading = bodyStartsWithDuplicateTitleHeading(entry.data.title, entryBody);
const hasRenderableBody = entryBody.trim().length > 0;
const isImageOnlyObject = Boolean(entry.data.image_only);
const socialImage = mediaImages[0] || directImages[0] || inlineBodyImages[0];
const socialImageAlt = entry.data.media.find(
  (item) => item.kind === 'image' && item.src.trim() === socialImage
)?.alt || `${displayTitle} — Codex Archive`;
const marginaliaEntries = getMarginaliaEntriesForTarget(await getAllEntries(), entry.data.id);
const mythmechMarginaliaEntries = getMythmechMarginaliaEntries(marginaliaEntries);
const canonicalObjectPath = getObjectPath(entry);
const structuredData = getObjectJsonLd(entry);
const sidecars = await loadObjectSidecars(entry.filePath);
const captureMeta = sidecars.capture;
const objectForm =
  normalizeObjectForm(captureMeta?.object_form_lock) ||
  normalizeObjectForm(captureMeta?.object_form_suggestion);
const objectFormNote = getObjectFormNote(objectForm, captureMeta);
const alternateLinks = [
  {
    href: getObjectJsonPath(entry),
    type: 'application/json',
    title: `${displayTitle} JSON export`,
  },
  {
    href: getObjectMarkdownPath(entry),
    type: 'text/markdown',
    title: `${displayTitle} Markdown export`,
  },
];
---

<BaseLayout
  title={`${displayTitle} | Codex`}
  description={summary || 'Carrier Pigeon codex entry'}
  canonicalPath={canonicalObjectPath}
  socialType="article"
  socialImage={socialImage}
  socialImageAlt={socialImageAlt}
  twitterCard={socialImage ? 'summary_large_image' : 'summary'}
  structuredData={structuredData}
  alternateLinks={alternateLinks}
>
  <article class="codex-shell">
    <a class="back" href="/">← Back to archive</a>

    <header class="head">
      <div class="eyebrow">
        <ObjectIdentityBadge type="codex" form={objectForm || undefined} showIcon={true} />
        <span>{state}</span>
      </div>
      <h1>{displayTitle}</h1>
      <div class="meta">
        <span>{readableDate}</span>
        {axes.length > 0 && <span>{axes.length} axes</span>}
        {tags.length > 0 && <span>{tags.length} tags</span>}
      </div>
      {objectForm && (
        <div class={`object-form-banner object-form-banner--${objectForm}`}>
          <p class="object-form-banner-kicker">{objectFormNote?.label || 'Object Form'}</p>
          <p>{objectFormNote ? objectFormNote.text : objectFormDescription(objectForm)}</p>
        </div>
      )}
      {axes.length > 0 && (
        <div class="axis-block" aria-label="Axes">
          <p class="axis-label">Axes</p>
          <ul class="tag-list tag-list--axes">
            {axes.map((axis) => (
              <li>{axis.label}: {axis.displayValue}</li>
            ))}
          </ul>
        </div>
      )}
      {tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="object-flow">
      <div class="object-flow-main">
        {galleryImages.length > 0 && (
        <section class={`gallery ${isImageOnlyObject ? 'gallery--image-only' : ''}`} aria-label="Attached images">
          {galleryImages.map((image, index) => (
            <a href={image} target="_blank" rel="noreferrer">
              <img src={image} alt={`${displayTitle} image ${index + 1}`} loading="lazy" />
            </a>
          ))}
        </section>
      )}

        {hasRenderableBody && (
          <section class={`body ${hideLeadHeading ? 'body--hide-lead-heading' : ''}`}>
            <Content />
          </section>
        )}

        <InspectModePanel
          slug={entry.slug}
          packet={sidecars.packet}
          respawn={sidecars.respawn}
          mythmech={sidecars.mythmech}
          platePrompt={sidecars.platePrompt}
          marginaliaEntries={mythmechMarginaliaEntries}
        />

        <MarginaliaPanel objectId={entry.data.id} objectTitle={displayTitle} items={marginaliaEntries} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .codex-shell {
    padding: 4.4rem 0 5.8rem;
  }

  .back {
    display: inline-block;
    color: var(--mid);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: var(--ls-ui);
    transition: 0.12s;
  }

  .back:hover {
    color: var(--star);
  }

  .head {
    margin-top: 1.3rem;
    max-width: 46rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .head h1 {
    margin: 1rem 0 0;
    line-height: 1.18;
  }

  .meta {
    margin-top: 1.15rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.7rem;
  }

  .meta span {
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: var(--ls-ui);
  }

  .meta span + span {
    position: relative;
    padding-left: 0.72rem;
  }

  .meta span + span::before {
    content: '·';
    position: absolute;
    left: 0.12rem;
    color: var(--ghost);
  }

  .object-form-banner {
    margin-top: 1rem;
    display: grid;
    gap: 0.4rem;
    max-width: 44rem;
  }

  .object-form-banner-kicker {
    margin: 0;
    color: rgba(226, 201, 164, 0.78);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: var(--ls-ui-wide);
    text-transform: uppercase;
  }

  .object-form-banner p {
    margin: 0;
    color: var(--text-body);
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .tag-list {
    margin: 1.35rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }

  .tag-list li {
    padding: 0.28rem 0.7rem;
    border: 1px solid rgba(201, 150, 58, 0.28);
    border-radius: 999px;
    color: var(--gold);
    background: rgba(201, 150, 58, 0.1);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .axis-block {
    margin-top: 1.3rem;
  }

  .axis-label {
    margin: 0;
    color: var(--mid);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: var(--ls-ui);
    text-transform: uppercase;
  }

  .tag-list--axes {
    margin-top: 0.7rem;
  }

  .object-flow {
    margin-top: 1.8rem;
  }

  .object-flow-main {
    min-width: 0;
  }

  .gallery {
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .gallery--image-only {
    grid-template-columns: 1fr;
    max-width: min(48rem, 100%);
  }

  .gallery a {
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }

  .gallery--image-only a {
    justify-self: center;
    width: 100%;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
  }

  .gallery--image-only img {
    min-height: 0;
    max-height: min(78vh, 56rem);
    object-fit: contain;
    background: rgba(11, 9, 8, 0.92);
  }

  .body {
    margin-top: 3rem;
    max-width: 42rem;
    line-height: 1.95;
  }

  .body--hide-lead-heading > :global(h1:first-child),
  .body--hide-lead-heading > :global(p:first-child) {
    display: none;
  }

  .body :global(h2),
  .body :global(h3) {
    margin: 2.8rem 0 1rem;
    color: var(--star);
    line-height: 1.25;
  }

  .body :global(p),
  .body :global(li),
  .body :global(blockquote) {
    color: var(--text-body);
    font-size: 1.12rem;
  }

  .body :global(p),
  .body :global(ul),
  .body :global(ol),
  .body :global(blockquote) {
    margin: 0 0 1.6rem;
  }

  .body :global(a) {
    color: var(--gold);
  }

  .body :global(hr) {
    width: min(74ch, 100%);
    margin: 1.05rem 0 2.9rem;
    border: 0;
    border-top: 2px solid rgb(102 77 26);
    opacity: 0.96;
  }

  .body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(58vh, 760px);
    margin: 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(11, 9, 8, 0.92);
    object-fit: contain;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 0 0 1px rgba(0, 0, 0, 0.18);
  }

  .body :global(p > img:only-child) {
    max-width: min(100%, 42rem);
  }

  @media (max-width: 720px) {
    .codex-shell {
      padding-top: 3.5rem;
    }

    .gallery {
      grid-template-columns: 1fr;
    }

    .body :global(img) {
      max-height: min(52vh, 34rem);
    }
  }
</style>
