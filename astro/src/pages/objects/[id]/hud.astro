---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FieldSurface from '../../../components/hud/FieldSurface.astro';
import { getAllEntries } from '../../../lib/archive';
import { formatDisplayTitle } from '../../../lib/headline';
import { loadObjectSidecars } from '../../../lib/loadObjectSidecars';
import { getMarginaliaEntriesForTarget, getMythmechMarginaliaEntries } from '../../../lib/marginalia';
import { getObjectPath, getObjectSlug, matchesObjectParam } from '../../../lib/objectInterop';

export async function getStaticPaths() {
  const entries = (await getAllEntries()).filter(
    (entry) =>
      entry.data.status === 'published' &&
      (entry.data.visibility === 'public' || entry.data.visibility === 'unlisted')
  );

  return entries.map((entry) => ({
    params: { id: getObjectSlug(entry) },
  }));
}

const entries = (await getAllEntries()).filter(
  (entry) =>
    entry.data.status === 'published' &&
    (entry.data.visibility === 'public' || entry.data.visibility === 'unlisted')
);
const entry = entries.find((candidate) => matchesObjectParam(candidate, Astro.params.id));

if (!entry) {
  throw new Error(`Object not found for id: ${Astro.params.id}`);
}

const slug = getObjectSlug(entry);
const objectUrl = getObjectPath(entry);
const { packet, respawn, mythmech, platePrompt } = await loadObjectSidecars(entry.filePath);
const mythmechMarginaliaEntries = getMythmechMarginaliaEntries(getMarginaliaEntriesForTarget(entries, entry.data.id));
const displayTitle = formatDisplayTitle(entry.data.title);
const canonicalPath = `${getObjectPath(entry)}/hud`;
---

<BaseLayout
  title={`${displayTitle} · HUD`}
  description={`HUD surface for ${displayTitle}.`}
  canonicalPath={canonicalPath}
>
  <FieldSurface
    title={displayTitle}
    objectUrl={objectUrl}
    packet={packet}
    mythmech={mythmech}
    platePrompt={platePrompt}
    marginaliaEntries={mythmechMarginaliaEntries}
    sourceText={entry.body}
    respawn={respawn}
  />
</BaseLayout>
